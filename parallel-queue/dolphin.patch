diff --git a/Source/Core/Core/Slippi/SlippiQueueControl.h b/Source/Core/Core/Slippi/SlippiQueueControl.h
new file mode 100644
index 0000000..d79375d
--- /dev/null
+++ b/Source/Core/Core/Slippi/SlippiQueueControl.h
@@ -0,0 +1,125 @@
+// Copyright 2026 Dolphin Emulator Project
+// Licensed under GPLv2+
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// Private, versioned extension for this development fork. Not a stock Slippi API.
+// The game must discover the capability before exposing a parallel-queue option.
+// Calls are serialized on the emulated CPU / EXI thread.
+class SlippiQueueControl
+{
+public:
+  static constexpr std::uint8_t Command = 0xe6;
+  static constexpr std::size_t RequestBytes = 12;
+  using Reply = std::array<std::uint8_t, 16>;
+  enum class Mode : std::uint8_t { Ranked = 0, Unranked = 1, Direct = 2, Teams = 3, None = 0xff };
+  static bool IsSinglesMode(Mode mode) { return mode == Mode::Direct || mode == Mode::Unranked; }
+  static bool ShouldYieldToTeams(Mode mode, bool singlesConnected, bool teamsConnected)
+  {
+    return IsSinglesMode(mode) && singlesConnected && teamsConnected;
+  }
+  enum class Op : std::uint8_t { Capabilities, ParkTeams, Status, ActivateTeams, CancelTeams };
+  enum class Result : std::uint8_t
+  {
+    Ok, Malformed, UnsupportedVersion, UnsupportedOperation, StaleGeneration,
+    NoTeams, AlreadyParked, WrongMode, Busy, NotReady, InternalError
+  };
+  class Backend
+  {
+  public:
+    virtual ~Backend() = default;
+    virtual Mode ForegroundMode() const = 0;
+    virtual bool ForegroundBusy() const = 0;
+    virtual bool CanParkTeams() const = 0;
+    virtual bool HasTeams() const = 0;
+    virtual bool TeamsReady() const = 0;
+    virtual bool TeamsFailed() const = 0;
+    virtual void ParkTeams() = 0;
+    virtual void ActivateTeams() = 0;
+    virtual void CancelTeams() = 0;
+  };
+
+  Reply Handle(const std::uint8_t* request, std::size_t size, Backend& backend)
+  {
+    Result result = Result::Ok;
+    if (request == nullptr || size != RequestBytes || request[0] != 'P' || request[1] != 'F' ||
+        request[2] != 'D' || request[3] != 'Q' || request[6] != 0 || request[7] != 0)
+      return Respond(Result::Malformed, backend);
+    if (request[4] != 1)
+      return Respond(Result::UnsupportedVersion, backend);
+    const auto op = static_cast<Op>(request[5]);
+    const std::uint32_t generation = (std::uint32_t(request[8]) << 24) |
+        (std::uint32_t(request[9]) << 16) | (std::uint32_t(request[10]) << 8) | request[11];
+    switch (op)
+    {
+    case Op::Capabilities:
+    case Op::Status:
+      break;
+    case Op::ParkTeams:
+      if (generation != 0)
+        result = Result::StaleGeneration;
+      else if (backend.HasTeams())
+        result = Result::AlreadyParked;
+      else if (backend.ForegroundMode() != Mode::Teams)
+        result = Result::WrongMode;
+      else if (!backend.CanParkTeams())
+        result = Result::Busy;
+      else
+      {
+        backend.ParkTeams();
+        AdvanceGeneration();
+      }
+      break;
+    case Op::ActivateTeams:
+    case Op::CancelTeams:
+      if (generation == 0 || generation != m_generation)
+        result = Result::StaleGeneration;
+      else if (!backend.HasTeams())
+        result = Result::NoTeams;
+      else if (op == Op::ActivateTeams && backend.ForegroundBusy())
+        result = Result::Busy;
+      else if (op == Op::ActivateTeams && !backend.TeamsReady())
+        result = Result::NotReady;
+      else
+      {
+        if (op == Op::ActivateTeams)
+          backend.ActivateTeams();
+        else
+          backend.CancelTeams();
+        AdvanceGeneration();
+      }
+      break;
+    default:
+      result = Result::UnsupportedOperation;
+      break;
+    }
+    return Respond(result, backend);
+  }
+
+  Reply Respond(Result result, const Backend& backend) const
+  {
+    Reply out{{'P', 'F', 'D', 'Q', 1, static_cast<std::uint8_t>(result), 0,
+               static_cast<std::uint8_t>(backend.ForegroundMode()), 0, 0, 0, 0, 0, 0, 0, 15}};
+    if (backend.HasTeams())
+    {
+      out[6] |= 1;
+      // A peer can disconnect between queries; never publish failed AND ready.
+      if (backend.TeamsFailed()) out[6] |= 4;
+      else if (backend.TeamsReady()) out[6] |= 2;
+    }
+    out[8] = static_cast<std::uint8_t>(m_generation >> 24);
+    out[9] = static_cast<std::uint8_t>(m_generation >> 16);
+    out[10] = static_cast<std::uint8_t>(m_generation >> 8);
+    out[11] = static_cast<std::uint8_t>(m_generation);
+    return out;
+  }
+
+private:
+  void AdvanceGeneration() { if (++m_generation == 0) ++m_generation; }
+  std::uint32_t m_generation = 0;
+};
diff --git a/Source/Core/Core/Slippi/SlippiRustAccess.h b/Source/Core/Core/Slippi/SlippiRustAccess.h
new file mode 100644
index 0000000..4721eb4
--- /dev/null
+++ b/Source/Core/Core/Slippi/SlippiRustAccess.h
@@ -0,0 +1,25 @@
+// Copyright 2026 Dolphin Emulator Project. Licensed under GPLv2+.
+#pragma once
+#include <memory>
+#include <mutex>
+#include <utility>
+
+// The current Rust FFI temporarily reconstructs an owning Box and passes a
+// mutable device reference for each opaque device call. Calls on the same device must never overlap. Copies of
+// this access object share the gate across EXI, user, codes and matchmaking.
+class SlippiRustAccess
+{
+public:
+  SlippiRustAccess() : m_mutex(std::make_shared<std::recursive_mutex>()) {}
+  std::unique_lock<std::recursive_mutex> Lock() const
+  {
+    return std::unique_lock<std::recursive_mutex>(*m_mutex);
+  }
+  template <typename F> auto Call(F&& call) const -> decltype(call())
+  {
+    auto lock = Lock();
+    return call();
+  }
+private:
+  std::shared_ptr<std::recursive_mutex> m_mutex;
+};
diff --git a/Source/Core/Core/Slippi/SlippiSessionBarrier.h b/Source/Core/Core/Slippi/SlippiSessionBarrier.h
new file mode 100644
index 0000000..60da1b0
--- /dev/null
+++ b/Source/Core/Core/Slippi/SlippiSessionBarrier.h
@@ -0,0 +1,27 @@
+// Copyright 2026 Dolphin Emulator Project
+// Licensed under GPLv2+
+// Refer to the license.txt file included.
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+// CPU-thread gameplay/report state plus a producer/worker replay drain barrier.
+// A connection cleanup alone does not prove that the previous game is finished.
+class SlippiSessionBarrier
+{
+public:
+  void BeginOnlineGame() { m_gameplay = true; m_report = true; }
+  void EndGame() { m_gameplay = false; }
+  void ReportFinished() { m_report = false; }
+  void ReplayQueued() { m_submitted.fetch_add(1, std::memory_order_release); }
+  void ReplayWritten() { m_completed.fetch_add(1, std::memory_order_release); }
+  bool OnlineIdle() const { return !m_gameplay && !m_report; }
+  bool Idle() const
+  {
+    return OnlineIdle() &&
+        m_submitted.load(std::memory_order_acquire) == m_completed.load(std::memory_order_acquire);
+  }
+private:
+  bool m_gameplay = false, m_report = false;
+  std::atomic<std::uint64_t> m_submitted{0}, m_completed{0};
+};
