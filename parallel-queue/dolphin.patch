+std::unique_ptr<SlippiMatchmaking> CEXISlippi::createForegroundMatchmaking()
+{
+	// Peer construction is not gameplay activation. The foreground match-state
+	// path publishes the active client only when it takes ownership of it.
+	return std::make_unique<SlippiMatchmaking>(slprs_exi_device_ptr, user.get(), false, !m_pendingTeams);
+}
+
+void CEXISlippi::queueConnectionCleanup(std::unique_ptr<SlippiMatchmaking> mm,
+                                        std::unique_ptr<SlippiNetplayClient> client)
+{
+	try
+	{
+		for (auto it = m_connectionCleanup.begin(); it != m_connectionCleanup.end();)
+		{
+			if (it->wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+				it = m_connectionCleanup.erase(it);
+			else
+				++it;
+		}
+		m_connectionCleanup.emplace_back(
+		    std::async(std::launch::async, doConnectionCleanup, std::move(mm), std::move(client)));
+	}
+	catch (const std::exception& error)
+	{
+		// If a worker cannot be started/stored, argument/future destruction still
+		// owns and finishes cleanup here. No detached worker may outlive the device.
+		WARN_LOG(SLIPPI_ONLINE, "Connection cleanup completed synchronously: %s", error.what());
+	}
+}
+
+SlippiQueueControl::Mode CEXISlippi::ForegroundMode() const
+{
+	if (!matchmaking || matchmaking->GetMatchmakeState() == SlippiMatchmaking::IDLE)
+		return SlippiQueueControl::Mode::None;
+	return static_cast<SlippiQueueControl::Mode>(lastSearch.mode);
+}
+
+bool CEXISlippi::ForegroundBusy() const
+{
+	return !m_sessionBarrier.Idle() || slippi_netplay || isPlaySessionActive ||
+	       (matchmaking && matchmaking->IsSearching());
+}
+
+bool CEXISlippi::CanParkTeams() const
+{
+	return matchmaking && lastSearch.mode == SlippiMatchmaking::TEAMS &&
+	       matchmaking->IsSearching() && !slippi_netplay && !isPlaySessionActive &&
+	       m_sessionBarrier.OnlineIdle() && forcedError.empty();
+}
+
+bool CEXISlippi::HasTeams() const { return m_pendingTeams != nullptr; }
+bool CEXISlippi::TeamsReady() const
+{
+	return m_pendingTeams && m_pendingTeams->matchmaking->HasConnectedPeers();
+}
+bool CEXISlippi::TeamsFailed() const
+{
+	if (!m_pendingTeams)
+		return false;
+	const auto state = m_pendingTeams->matchmaking->GetMatchmakeState();
+	return state == SlippiMatchmaking::ERROR_ENCOUNTERED ||
+	       (state == SlippiMatchmaking::CONNECTION_SUCCESS && !TeamsReady());
+}
+
+void CEXISlippi::ParkTeams()
+{
+	// Allocate all new state before moving ownership of the existing search.
+	auto fresh = std::make_unique<SlippiMatchmaking>(slprs_exi_device_ptr, user.get(), false, false);
+	auto pending = std::make_unique<PendingTeams>();
+	pending->search = lastSearch;
+	pending->selections = localSelections;
+	pending->allowedStages = allowedStages;
+	pending->stagePool = stagePool;
+	pending->matchmaking = std::move(matchmaking);
+	m_pendingTeams = std::move(pending);
+	matchmaking = std::move(fresh);
+	localSelections.Reset();
+	stagePool.clear();
+	forcedError.clear();
+	overwrite_selections.clear();
+	isPlaySessionActive = false;
+	lastSearch = SlippiMatchmaking::MatchSearchSettings();
+	recentMmResult = SlippiMatchmaking::MatchmakeResult();
+	INFO_LOG(SLIPPI_ONLINE, "[Parallel queue] Teams search parked; foreground available for singles");
+}
+
+void CEXISlippi::ActivateTeams()
+{
+	// The game must end singles and issue normal foreground cleanup first.
+	// Never swap transports underneath live singles input/rollback processing.
+	queueConnectionCleanup(std::move(matchmaking), std::move(slippi_netplay));
+	matchmaking = std::move(m_pendingTeams->matchmaking);
+	lastSearch = std::move(m_pendingTeams->search);
+	localSelections = m_pendingTeams->selections;
+	allowedStages = std::move(m_pendingTeams->allowedStages);
+	stagePool = std::move(m_pendingTeams->stagePool);
+	m_pendingTeams.reset();
+	m_restoredTeamsSelections = true;
+	forcedError.clear();
+	overwrite_selections.clear();
+	isPlaySessionActive = false;
+	recentMmResult = SlippiMatchmaking::MatchmakeResult();
+	activeSavestates.clear();
+	availableSavestates.clear();
+	INFO_LOG(SLIPPI_ONLINE, "[Parallel queue] Teams restored; waiting for game lobby setup");
+}
+
+void CEXISlippi::CancelTeams()
+{
+	if (!m_pendingTeams)
+		return;
+	queueConnectionCleanup(std::move(m_pendingTeams->matchmaking), nullptr);
+	m_pendingTeams.reset();
+}
+
+void CEXISlippi::handleQueueControl(const u8* payload, size_t length)
+{
+	SlippiQueueControl::Reply reply;
+	try { reply = m_queueControl.Handle(payload, length, *this); }
+	catch (const std::exception& error)
+	{
+		ERROR_LOG(SLIPPI_ONLINE, "[Parallel queue] Control failed: %s", error.what());
