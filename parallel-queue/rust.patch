+#[cfg(test)]
+mod parallel_tests {
+    use super::*;
+    use slippi_gg_api::APIClient;
+    use std::net::TcpListener;
+    use std::sync::mpsc;
+
+    fn client(url: String) -> MatchmakingClient {
+        // Synthetic identity only. This test never contacts the public service.
+        let dir = std::env::temp_dir().join(format!("pfq-mm-{}", std::process::id()));
+        let user = UserManager::new(APIClient::new("3.7.0"), dir, "3.7.0".into());
+        user.set(|u| {
+            u.uid = "test-pfq".into();
+            u.play_key = "test-only".into();
+        });
+        let mut client = MatchmakingClient::new(user, "3.7.0".into());
+        client.url = url;
+        client
+    }
+
+    fn wait(client: &MatchmakingClient, wanted: MatchmakingState) {
+        let start = Instant::now();
+        while client.state() != wanted {
+            assert_ne!(client.state(), MatchmakingState::Failed, "{}", client.error_message());
+            assert!(
+                start.elapsed() < Duration::from_secs(5),
+                "waiting for {wanted:?}, got {:?}",
+                client.state()
+            );
+            thread::sleep(Duration::from_millis(5));
+        }
+    }
+
+    #[test]
+    fn cancelling_or_dropping_an_independent_client_preserves_other_state() {
+        let base = client("ws://127.0.0.1:1/unused".into());
+        let teams = base.independent();
+        let singles = base.independent();
+        for mm in [&teams, &singles] {
+            let mut inner = mm.inner.lock().unwrap();
+            inner.session_id = 1;
+            inner.shared.set_state(MatchmakingState::Queued);
+        }
+        singles.cancel_session(1);
+        assert!(singles.inner.lock().unwrap().shared.cancelled());
+        assert!(!teams.inner.lock().unwrap().shared.cancelled());
+        drop(singles);
+        assert_eq!(teams.state(), MatchmakingState::Queued);
+        assert!(!teams.inner.lock().unwrap().shared.cancelled());
+        assert_eq!(base.state(), MatchmakingState::Idle);
+        // A stale generation cannot cancel a newer search on the same client.
+        teams.inner.lock().unwrap().session_id = 2;
+        teams.cancel_session(1);
+        assert!(!teams.inner.lock().unwrap().shared.cancelled());
+        teams.cancel_session(2);
+        assert!(teams.inner.lock().unwrap().shared.cancelled());
+    }
+
+    #[test]
+    fn two_websocket_queues_share_identity_but_not_cancel_or_match_results() {
+        for (keep_mode, cancel_mode) in [(3, 1), (1, 3)] {
+            let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+            let teams = client(format!("ws://{}/v1/queue", listener.local_addr().unwrap()));
+            let singles = teams.independent();
+            let (events_tx, events_rx) = mpsc::channel();
+            let (match_tx, match_rx) = mpsc::channel();
+            let server = thread::spawn(move || {
+                let mut workers = Vec::new();
+                let mut match_rx = Some(match_rx);
+                for _ in 0..2 {
+                    let (stream, _) = listener.accept().unwrap();
+                    stream.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+                    let tx = events_tx.clone();
+                    // The first connection is the queue that must survive cancellation.
+                    let trigger = match_rx.take();
+                    workers.push(thread::spawn(move || {
+                        let mut socket = tungstenite::accept(stream).unwrap();
+                        let join: serde_json::Value = serde_json::from_str(socket.read().unwrap().to_text().unwrap()).unwrap();
+                        tx.send(join.clone()).unwrap();
+                        socket
+                            .send(Message::text(
+                                r#"{"type":"joined","ticketId":"test-ticket","token":"test-token"}"#,
+                            ))
+                            .unwrap();
+                        if let Some(trigger) = trigger {
+                            trigger.recv_timeout(Duration::from_secs(5)).unwrap();
+                            socket
+                                .send(Message::text(
+                                    r#"{"type":"match","matchId":"mode.retained-test","isHost":true}"#,
+                                ))
+                                .unwrap();
+                        } else {
+                            loop {
+                                match socket.read().unwrap() {
+                                    Message::Text(text) if text.contains("cancel") => {
+                                        tx.send(serde_json::json!({"cancelled": 1})).unwrap();
+                                        break;
+                                    },
+                                    Message::Ping(_) => {
+                                        socket.flush().unwrap();
+                                    },
+                                    _ => {},
+                                }
+                            }
+                        }
+                    }));
+                }
+                for worker in workers {
+                    worker.join().unwrap();
+                }
+            });
+            let team_id = teams.start(MatchRequest {
+                mode: keep_mode,
+                netplay_port: 41000,
+                ..Default::default()
+            });
+            let team_join = events_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+            wait(&teams, MatchmakingState::Queued);
+            let single_id = singles.start(MatchRequest {
+                mode: cancel_mode,
+                netplay_port: 41001,
+                ..Default::default()
+            });
+            let single_join = events_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+            wait(&singles, MatchmakingState::Queued);
+            assert_eq!(team_join["user"], single_join["user"]);
+            assert_eq!(team_join["search"]["mode"], keep_mode);
+            assert_eq!(single_join["search"]["mode"], cancel_mode);
+            assert_ne!(team_join["port"], single_join["port"]);
+            // Both clients may use session 1: the handle, not that number, isolates them.
+            assert_eq!(team_id, single_id);
+            singles.cancel_session(single_id);
+            assert_eq!(events_rx.recv_timeout(Duration::from_secs(5)).unwrap()["cancelled"], 1);
+            wait(&singles, MatchmakingState::Idle);
+            assert_eq!(teams.state(), MatchmakingState::Queued);
+            assert!(teams.take_result_json().is_none());
+            drop(singles);
+            match_tx.send(()).unwrap();
+            wait(&teams, MatchmakingState::Matched);
+            assert!(teams.take_result_json().unwrap().contains("mode.retained-test"));
+            assert!(teams.take_result_json().is_none());
+            server.join().unwrap();
+        }
+    }
