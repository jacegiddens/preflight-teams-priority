@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Create a checksum-bound COPY/DATA recipe. Does not bundle original modules."""
+import argparse, base64, difflib, hashlib, json
+from pathlib import Path
+
+def recipe(original, modified):
+    # Prefer original spans for both code and unchanged relocation tables.
+    matcher=difflib.SequenceMatcher(None,original,modified,autojunk=True)
+    operations=[];cursor=0
+    for a,b,size in matcher.get_matching_blocks():
+        if b>cursor:operations.append({'Data':base64.b64encode(modified[cursor:b]).decode('ascii')})
+        if size:operations.append({'Copy':a,'Length':size})
+        cursor=b+size
+    return {'OriginalBytes':len(original),'OriginalSHA256':hashlib.sha256(original).hexdigest(),
+            'OutputBytes':len(modified),'OutputSHA256':hashlib.sha256(modified).hexdigest(),
+            'Operations':operations}
+
+def apply(original, patch):
+    if len(original)!=patch['OriginalBytes'] or hashlib.sha256(original).hexdigest()!=patch['OriginalSHA256']:
+        raise ValueError('Original does not match')
+    out=bytearray()
+    for op in patch['Operations']:
+        if 'Copy' in op:
+            start,size=op['Copy'],op['Length']
+            if start<0 or size<0 or start+size>len(original):raise ValueError('Invalid copy range')
+            out.extend(original[start:start+size])
+        else:out.extend(base64.b64decode(op['Data'],validate=True))
+    if len(out)!=patch['OutputBytes'] or hashlib.sha256(out).hexdigest()!=patch['OutputSHA256']:
+        raise ValueError('Patched result does not match')
+    return bytes(out)
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__);ap.add_argument('originals',type=Path);ap.add_argument('modified',type=Path);ap.add_argument('output',type=Path)
+    args=ap.parse_args()
+    files={}
+    for name in ['tm.dat','other.dat']:
+        original=(args.originals/name).read_bytes();modified=(args.modified/name).read_bytes()
+        patch=recipe(original,modified)
+        if apply(original,patch)!=modified:raise ValueError('Recipe roundtrip failed')
+        files[name]=patch
+    doc={'Format':'Preflight parallel queue experimental patch 1','DolSHA256':'f604e1399f2dc88e2fbbaa2b3441867ca34d00b99b82e16bee4e4ef108604805',
+         'CodesSHA256':'1fdf6c7f11268e39d6bd68124b1b287008869f3e941851eb19b23a34dd54701d','Files':files}
+    if args.output.exists():raise ValueError('Output exists')
+    args.output.write_text(json.dumps(doc,separators=(',',':'))+'\n')
+    print('Roundtrip verified:',args.output)
+if __name__=='__main__':main()
diff --git a/Development/SingleInstance/Tools/test_ppc_hooks.py b/Development/SingleInstance/Tools/test_ppc_hooks.py
new file mode 100644
index 0000000..7378c98
--- /dev/null
+++ b/Development/SingleInstance/Tools/test_ppc_hooks.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python3
+"""Execute compiled big-endian PowerPC adapters with mocked game/EXI services.
+This is an adapter regression test, not a Dolphin or live-match test.
+"""
+import argparse
+import struct
+import sys
+from pathlib import Path
+from elftools.elf.elffile import ELFFile
+from unicorn import Uc, UC_ARCH_PPC, UC_MODE_32, UC_MODE_BIG_ENDIAN, UC_HOOK_CODE
+from unicorn import ppc_const as PPC
+from analyze_preflight import Module
+from build_preflight_modules import build, HASHES
+
+checks=0
+def check(value, why):
+    global checks
+    if not value: raise AssertionError(why)
+    checks+=1
+
+def w32(value): return struct.pack('>I', value)
+
+class Machine:
+    def __init__(self, name, original, obj, stock=False):
+        self.name=name;self.base=0x81000000
+        self.module=Module(build(name,original,obj))
+        self.u=Uc(UC_ARCH_PPC,UC_MODE_32|UC_MODE_BIG_ENDIAN)
+        self.u.mem_map(0x80000000,0x1800000)
+        self.u.mem_write(self.base,self.module.relocated(self.base))
+        self.stock=stock;self.foreground=3;self.parked=False;self.connected=False
+        self.busy=False;self.failed=False;self.token=0;self.tx=b'';self.rx=b''
+        self.calls=[];self.actions=[];self.old_frames=0;self.selected=[]
+        self.symbols={}
+        with open(obj_path(name),'rb') as f:
+            elf=ELFFile(f)
+            for s in elf.get_section_by_name('.symtab').iter_symbols():
+                if s.name.startswith('PFQ_') and isinstance(s['st_shndx'],int):
+                    self.symbols[s.name]=self.base+len(Module(original).code)+s['st_value']
+        self.u.hook_add(UC_HOOK_CODE,self.hook)
+        self.scene(0x1c,2) if name=='tm.dat' else self.scene(8,0)
+        self.write(0x804d6640,b'\x03')
+    def write(self,at,data): self.u.mem_write(at,data)
+    def read32(self,at): return struct.unpack('>I',self.u.mem_read(at,4))[0]
+    def scene(self,major,minor):self.write(0x80479d30,bytes([major,0,0,minor]))
+    def ret(self):self.u.reg_write(PPC.UC_PPC_REG_PC,self.u.reg_read(PPC.UC_PPC_REG_LR))
+    def control(self,tx):
+        op=tx[6];generation=int.from_bytes(tx[9:13],'big');result=0
+        self.calls.append(op)
+        if op==1:
+            if self.parked:result=6
+            elif self.foreground!=3:result=7
+            elif self.busy:result=8
+            else:self.parked=True;self.foreground=255;self.token+=1
+        if op in (3,4):
+            if generation!=self.token or not generation:result=4
+            elif not self.parked:result=5
+            elif op==3 and self.busy:result=8
+            elif op==3 and not self.connected:result=9
+            else:
+                self.parked=False;self.token+=1
+                if op==3:self.foreground=3
+        flags=(1|(4 if self.failed else 2 if self.connected else 0)) if self.parked else 0
+        return b'PFDQ'+bytes([1,result,flags,self.foreground])+w32(self.token)+w32(15)
+    def hook(self,u,at,size,userdata):
+        if at==0x817f0000:u.emu_stop();return
+        r3=u.reg_read(PPC.UC_PPC_REG_3)
+        if at==0x800055f0:
+            length=u.reg_read(PPC.UC_PPC_REG_4);write=u.reg_read(PPC.UC_PPC_REG_5)
+            if write:
+                self.tx=bytes(u.mem_read(r3,length))
+                if self.tx[:1]==b'\xe6':
+                    check(len(self.tx)==13 and self.tx[1:6]==b'PFDQ\x01','compiled PPC sends correct EXI wire bytes')
+                    self.rx=b'\0'*16 if self.stock else self.control(self.tx)
