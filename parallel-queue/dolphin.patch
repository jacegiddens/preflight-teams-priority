diff --git a/Development/SingleInstance/Tools/Export-Preflight-ModFiles.ps1 b/Development/SingleInstance/Tools/Export-Preflight-ModFiles.ps1
new file mode 100644
index 0000000..de9db3b
--- /dev/null
+++ b/Development/SingleInstance/Tools/Export-Preflight-ModFiles.ps1
@@ -0,0 +1,97 @@
+param([string]$IsoPath='', [string]$OutputZip='', [switch]$NoOpen)
+$ErrorActionPreference='Stop'
+function Read-At([IO.BinaryReader]$Reader,[long]$Offset,[int]$Count) {
+    if($Offset -lt 0 -or $Count -lt 0 -or $Offset -gt $Reader.BaseStream.Length-$Count){throw 'A disc structure is outside the input file.'}
+    $Reader.BaseStream.Position=$Offset;$bytes=$Reader.ReadBytes($Count)
+    if($bytes.Length -ne $Count){throw 'The input file ended unexpectedly.'}
+    return ,$bytes
+}
+function Big32([byte[]]$Bytes,[int]$Offset) {
+    if($Offset -lt 0 -or $Offset+4 -gt $Bytes.Length){throw 'Invalid field offset.'}
+    return [uint64]$Bytes[$Offset]*16777216+[uint64]$Bytes[$Offset+1]*65536+[uint64]$Bytes[$Offset+2]*256+[uint64]$Bytes[$Offset+3]
+}
+function Hash([byte[]]$Bytes) {
+    $sha=[Security.Cryptography.SHA256]::Create()
+    try{return [BitConverter]::ToString($sha.ComputeHash($Bytes)).Replace('-','').ToLowerInvariant()}finally{$sha.Dispose()}
+}
+$temporary=''
+try {
+    if([string]::IsNullOrWhiteSpace($IsoPath)) {
+        Add-Type -AssemblyName System.Windows.Forms
+        $dialog=New-Object System.Windows.Forms.OpenFileDialog
+        $dialog.Title='Choose the same Preflight ISO you used for the first analysis'
+        $dialog.Filter='Uncompressed GameCube disc|*.iso;*.gcm'
+        try {if($dialog.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK){exit 0};$IsoPath=$dialog.FileName}finally{$dialog.Dispose()}
+    }
+    $stream=[IO.File]::Open([IO.Path]::GetFullPath($IsoPath),[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
+    $reader=New-Object IO.BinaryReader($stream)
+    $files=[ordered]@{};$metadata=[ordered]@{};$details=New-Object 'Collections.Generic.List[object]'
+    try {
+        $header=Read-At $reader 0 1088
+        if([Text.Encoding]::ASCII.GetString($header,0,6) -ne 'GALE01' -or (Big32 $header 28) -ne 3258163005){throw 'Choose your already-patched plain Preflight ISO or GCM. ZIP, RVZ and GCZ files are not supported.'}
+        $dolOffset=Big32 $header 1056;$fstOffset=Big32 $header 1060;$fstSize=Big32 $header 1064
+        if($dolOffset -lt 1088 -or $fstOffset -lt 1088 -or $fstSize -lt 12 -or $fstSize -gt 16777216){throw 'Invalid disc header.'}
+        $dh=Read-At $reader $dolOffset 256;[long]$dolSize=256
+        for($i=0;$i -lt 18;$i++) {
+            $offset=Big32 $dh ($i*4);$size=Big32 $dh (144+$i*4)
+            if($size -eq 0){continue}
+            if($offset -lt 256 -or $offset+$size -gt 33554432 -or $dolOffset+$offset+$size -gt $stream.Length){throw 'Invalid executable section.'}
+            $dolSize=[Math]::Max($dolSize,$offset+$size)
+        }
+        $dol=Read-At $reader $dolOffset $dolSize
+        $fst=Read-At $reader $fstOffset $fstSize;$count=Big32 $fst 8
+        if($fst[0] -ne 1 -or $count -lt 1 -or $count -gt 50000 -or $count*12 -gt $fst.Length){throw 'Invalid filesystem table.'}
+        $directories=New-Object 'Collections.Generic.List[object]';$directories.Add([pscustomobject]@{Path='';End=$count})
+        for($i=1;$i -lt $count;$i++) {
+            while($directories.Count -gt 1 -and $i -ge $directories[$directories.Count-1].End){$directories.RemoveAt($directories.Count-1)}
+            $word=Big32 $fst ($i*12);$start=[int]($count*12+($word -band 16777215))
+            if($start -lt $count*12 -or $start -ge $fst.Length){throw 'Invalid filesystem name.'}
+            $end=$start;while($end -lt $fst.Length -and $fst[$end] -ne 0 -and $end-$start -le 4096){$end++}
+            if($end -ge $fst.Length -or $end-$start -gt 4096){throw 'Invalid filesystem name length.'}
+            $name=[Text.Encoding]::UTF8.GetString($fst,$start,$end-$start);$path=$directories[$directories.Count-1].Path+$name
+            $offset=Big32 $fst ($i*12+4);$size=Big32 $fst ($i*12+8)
+            if(($word -shr 24) -eq 1) {
+                if($size -le $i -or $size -gt $directories[$directories.Count-1].End){throw 'Invalid directory subtree.'}
+                $directories.Add([pscustomobject]@{Path=($path+'/');End=$size})
+            } elseif(($word -shr 24) -eq 0) {
+                if($offset+$size -gt $stream.Length){throw 'A disc file is outside the input file.'}
+                if($path -ceq 'tm.dat' -or $path -ceq 'other.dat' -or $path -ceq 'codes.gct') {
+                    if($files.Contains($path)){throw 'Duplicate mod file in the filesystem.'}
+                    if($size -le 0 -or $size -gt 4194304){throw 'Unexpectedly large or empty mod file.'}
+                    $bytes=Read-At $reader $offset $size;$files[$path]=$bytes
+                    $details.Add([pscustomobject]@{Path=$path;Bytes=$bytes.Length;SHA256=(Hash $bytes)})
+                }
+            } else {throw 'Invalid filesystem entry type.'}
+        }
+        foreach($name in @('tm.dat','other.dat','codes.gct')){if(-not $files.Contains($name)){throw "Could not find $name. Choose the same patched Preflight ISO used for your earlier analysis."}}
+        $metadata=[ordered]@{Tool='Preflight focused read-only exporter 1';GameId='GALE01';Revision=$header[7];DiscBytes=$stream.Length;DolSHA256=(Hash $dol);Files=$details.ToArray()}
+    } finally {$reader.Dispose()}
+    if([string]::IsNullOrWhiteSpace($OutputZip)){$OutputZip=Join-Path ([Environment]::GetFolderPath('Desktop')) ('Preflight-ModFiles-'+[DateTime]::Now.ToString('yyyyMMdd-HHmmss')+'.zip')}
+    $OutputZip=[IO.Path]::GetFullPath($OutputZip)
+    if(Test-Path -LiteralPath $OutputZip){throw 'The output ZIP already exists. Choose a new name; existing files were preserved.'}
+    if(-not [IO.Directory]::Exists([IO.Path]::GetDirectoryName($OutputZip))){throw 'The output folder does not exist.'}
+    Add-Type -AssemblyName System.IO.Compression
+    $buffer=New-Object IO.MemoryStream
+    try {
+        $zip=New-Object IO.Compression.ZipArchive($buffer,[IO.Compression.ZipArchiveMode]::Create,$true)
+        try {
+            foreach($name in @('tm.dat','other.dat','codes.gct')) {
+                $entry=$zip.CreateEntry($name);$output=$entry.Open()
+                try{$bytes=[byte[]]$files[$name];$output.Write($bytes,0,$bytes.Length)}finally{$output.Dispose()}
+            }
+            $entry=$zip.CreateEntry('mod-report.json');$output=$entry.Open()
+            try{$json=$metadata|ConvertTo-Json -Depth 6;$bytes=[Text.Encoding]::UTF8.GetBytes($json);$output.Write($bytes,0,$bytes.Length)}finally{$output.Dispose()}
+        } finally {$zip.Dispose()}
+        $temporary=$OutputZip+'.'+[guid]::NewGuid().ToString('N')+'.partial'
+        $output=[IO.File]::Open($temporary,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
+        try{$buffer.Position=0;$buffer.CopyTo($output)}finally{$output.Dispose()}
+        [IO.File]::Move($temporary,$OutputZip);$temporary=''
+    } finally {$buffer.Dispose()}
+    Write-Host "Created: $OutputZip" -ForegroundColor Green
+    Write-Host 'Attach that ZIP in this chat. Your ISO was opened read-only and was not changed.'
+    if(-not $NoOpen){Start-Process explorer.exe -ArgumentList ('/select,"'+$OutputZip+'"')}
+} catch {
+    if($temporary.Length -ne 0 -and [IO.File]::Exists($temporary)){[IO.File]::Delete($temporary)}
+    Write-Host $_.Exception.Message -ForegroundColor Red
+    exit 1
+}
