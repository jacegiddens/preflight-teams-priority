+}
+
+void CEXISlippi::queueConnectionCleanup(std::unique_ptr<SlippiMatchmaking> mm,
+                                        std::unique_ptr<SlippiNetplayClient> client)
+{
+	try
+	{
+		for (auto it = m_connectionCleanup.begin(); it != m_connectionCleanup.end();)
+		{
+			if (it->wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+				it = m_connectionCleanup.erase(it);
+			else
+				++it;
+		}
+		m_connectionCleanup.emplace_back(
+		    std::async(std::launch::async, doConnectionCleanup, std::move(mm), std::move(client)));
+	}
+	catch (const std::exception& error)
+	{
+		// If a worker cannot be started/stored, argument/future destruction still
+		// owns and finishes cleanup here. No detached worker may outlive the device.
+		WARN_LOG(SLIPPI_ONLINE, "Connection cleanup completed synchronously: %s", error.what());
+	}
+}
