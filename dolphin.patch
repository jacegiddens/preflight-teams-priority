+--- a/ffi/includes/SlippiRustExtensions.h
++++ b/ffi/includes/SlippiRustExtensions.h
+@@ -546,6 +546,29 @@ bool slprs_match_quality_on_frame(struct SlippiMatchQualityFrame frame);
+  */
+ uint64_t slprs_mm_start(uintptr_t exi_device_instance_ptr, struct SlippiMatchmakingRequest request);
+ 
++/**
++ * Creates an independent matchmaking client sharing the device's user identity.
++ * Dolphin serializes this call with other opaque EXI-device calls. Thereafter
++ * each handle is owned by one C++ matchmaking context and used by its worker;
++ * destruction happens only after that worker has joined.
++ */
++uintptr_t slprs_mm_client_create(uintptr_t exi_device_instance_ptr);
++
++/**
++ * Destroys exactly this independent client; no other ticket is cancelled.
++ */
++void slprs_mm_client_destroy(uintptr_t client);
++
++uint64_t slprs_mm_client_start(uintptr_t client, struct SlippiMatchmakingRequest request);
++
++int slprs_mm_client_state(uintptr_t client);
++
