@@ -0,0 +1,13 @@
+Preflight mod-files exporter
+
+1. Extract this ZIP to a new folder.
+2. Double-click Export-Preflight-ModFiles.cmd.
+3. Choose the same already-patched Preflight.iso used for the first analysis.
+4. The tool creates Preflight-ModFiles-<timestamp>.zip on your Desktop and selects
+   it in File Explorer. Attach that generated ZIP in this chat.
+
+Only tm.dat, other.dat, codes.gct and a small metadata report are included.
+The main executable is hashed locally to link this export to the earlier report;
+it is not copied into the ZIP. The input ISO is opened read-only.
+No helper session, .dtm, REA installation, login or user.json is involved.
+Plain ISO/GCM files only. Existing output files are never overwritten.
diff --git a/Development/SingleInstance/Tools/analyze_preflight.py b/Development/SingleInstance/Tools/analyze_preflight.py
new file mode 100644
index 0000000..8bb9a76
--- /dev/null
+++ b/Development/SingleInstance/Tools/analyze_preflight.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""Read-only structural analysis of the supplied Preflight HSD function module.
+Offsets remain module-relative unless a user-selected analysis base is supplied.
+This tool does not modify an ISO or produce a playable mod.
+"""
+import argparse
+import collections
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+class Module:
+    def __init__(self, data):
+        self.raw = bytes(data)
+        if len(data) < 40 or len(data) > 16 * 1024 * 1024:
+            raise ValueError('Invalid module size')
+        size, body_size, nrel, nroot, nextern = struct.unpack_from('>5I', data)
+        if size != len(data) or body_size > size - 32:
+            raise ValueError('Invalid archive header')
+        self.body = data[32:32 + body_size]
+        table = 32 + body_size
+        names = table + nrel * 4 + (nroot + nextern) * 8
+        if names > size or nroot > 1024 or nrel > body_size // 4:
+            raise ValueError('Invalid archive tables')
+        def word(offset):
+            if offset < 0 or offset + 4 > len(data):
+                raise ValueError('Invalid word offset')
+            return struct.unpack_from('>I', data, offset)[0]
+        for i in range(nrel):
+            offset = word(table + i * 4)
+            if offset % 4 or offset + 4 > body_size:
+                raise ValueError('Invalid archive relocation')
+        roots = {}
+        for i in range(nroot):
+            offset, name_offset = struct.unpack_from('>2I', data, table + nrel * 4 + i * 8)
+            if offset >= body_size or names + name_offset >= size:
+                raise ValueError('Invalid root')
+            end = data.find(b'\0', names + name_offset)
+            if end < 0:
+                raise ValueError('Unterminated root name')
+            roots[data[names + name_offset:end].decode('ascii')] = offset
+        if 'fns' not in roots or roots['fns'] + 24 > body_size:
+            raise ValueError('Missing function root')
+        self.root_offset = roots['fns']
+        self.code_offset, reloc_offset, reloc_count, lookup, functions, debug = struct.unpack_from('>6I', self.body, self.root_offset)
+        if self.code_offset != 0 or reloc_offset > body_size or reloc_offset + reloc_count * 8 > body_size:
+            raise ValueError('Unsupported function layout')
+        if lookup + functions * 8 > body_size or functions > 10000:
+            raise ValueError('Invalid function lookup')
+        self.code = self.body[:reloc_offset]
+        self.relocs = []
+        sites = set()
+        for i in range(reloc_count):
+            packed, target = struct.unpack_from('>2I', self.body, reloc_offset + i * 8)
+            kind, site = packed >> 24, packed & 0xffffff
+            width = 2 if kind in (4, 6) else 4
+            if kind not in (1, 4, 6, 10, 26) or site % width or site + width > len(self.code) or site in sites:
+                raise ValueError('Unsupported or invalid code relocation')
+            sites.add(site)
+            self.relocs.append({'site': site, 'type': kind, 'target': target})
+        self.exports = [struct.unpack_from('>2I', self.body, lookup + i * 8) for i in range(functions)]
+        if any(off >= len(self.code) or off % 4 for _, off in self.exports):
+            raise ValueError('Invalid export offset')
+
+    def string(self, offset):
+        if not 0 <= offset < len(self.code):
+            return None
+        end = self.code.find(b'\0', offset, min(len(self.code), offset + 256))
+        if end <= offset:
+            return None
+        value = self.code[offset:end]
+        if not all(32 <= x < 127 for x in value):
+            return None
+        return value.decode('ascii')
+
+    def summary(self):
+        by_site = {r['site']: r for r in self.relocs}
+        labels = []
+        wanted = {'Queue', 'Queue Ranked', 'Queue Unranked', 'Queue Direct', 'Queue Teams', 'Queue Party', 'CPU Delay', 'Frame Advance', 'Block Connect Code'}
+        for r in self.relocs:
+            label = self.string(r['target']) if r['type'] == 1 else None
+            if label not in wanted:
+                continue
+            record = {'label': label, 'label_file_offset': 32 + r['target'], 'record_module_offset': r['site']}
+            for delta, key in [(12, 'callback_c'), (16, 'callback_10'), (28, 'context_1c')]:
+                pointer = by_site.get(r['site'] + delta)
+                if pointer and pointer['type'] == 1:
+                    record[key] = pointer['target']
+            if r['site'] + 28 <= len(self.code):
+                record['value_18'] = struct.unpack_from('>I', self.code, r['site'] + 24)[0]
+            labels.append(record)
+        exi_calls = [r for r in self.relocs if r['type'] == 10 and r['target'] == 0x800055f0]
+        return {
+            'sha256': hashlib.sha256(self.raw).hexdigest(), 'bytes': len(self.raw),
+            'code_and_data_bytes': len(self.code), 'root_file_offset': self.root_offset + 32,
+            'exports': [{'index': i, 'module_offset': off, 'file_offset': off + 32} for i, off in self.exports],
+            'relocation_types': dict(collections.Counter(r['type'] for r in self.relocs)),
+            'menu_records': labels, 'exi_transfer_calls': exi_calls,
+            'note': 'Menu field names are offsets; callback semantics require tracing their callers. No runtime addresses are inferred from module-relative offsets.'
+        }
+
+    def relocated(self, base):
+        if base % 4 or base < 0x80000000 or base + len(self.code) > 0x81800000:
+            raise ValueError('Choose an aligned MEM1 analysis base')
+        data = bytearray(self.code)
+        for r in self.relocs:
+            site, kind, target = r['site'], r['type'], r['target']
+            value = target if target >= 0x80000000 else base + target
+            if kind == 1:
+                struct.pack_into('>I', data, site, value)
+            elif kind == 4:
+                struct.pack_into('>H', data, site, value & 0xffff)
+            elif kind == 6:
+                struct.pack_into('>H', data, site, ((value + 0x8000) >> 16) & 0xffff)
+            elif kind == 10:
+                delta = value - (base + site)
+                if delta % 4 or not -(1 << 25) <= delta < (1 << 25):
+                    raise ValueError('Branch target out of range at analysis base')
+                instruction = struct.unpack_from('>I', data, site)[0]
+                if instruction >> 26 != 18:
+                    raise ValueError('REL24 site is not a branch instruction')
+                struct.pack_into('>I', data, site, (instruction & 0xfc000003) | (delta & 0x03fffffc))
+            elif kind == 26:
+                struct.pack_into('>I', data, site, (value - (base + site)) & 0xffffffff)
+        return bytes(data)
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('module', type=Path)
+    ap.add_argument('--output', type=Path, required=True)
+    args = ap.parse_args()
+    module = Module(args.module.read_bytes())
+    if args.output.exists():
+        ap.error('Output already exists; use a new filename')
+    args.output.write_text(json.dumps(module.summary(), indent=2) + '\n')
+    print('Saved read-only analysis:', args.output)
+
+if __name__ == '__main__':
+    main()
