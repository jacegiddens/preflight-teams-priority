index 0000000..8a5b5b0
--- /dev/null
+++ b/Development/SingleInstance/Tools/make_module_delta.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Create a checksum-bound COPY/DATA recipe. Does not bundle original modules."""
+import argparse, base64, difflib, hashlib, json
+from pathlib import Path
+
+def recipe(original, modified):
+    # Prefer original spans for both code and unchanged relocation tables.
+    matcher=difflib.SequenceMatcher(None,original,modified,autojunk=True)
+    operations=[];cursor=0
+    for a,b,size in matcher.get_matching_blocks():
+        if b>cursor:operations.append({'Data':base64.b64encode(modified[cursor:b]).decode('ascii')})
+        if size:operations.append({'Copy':a,'Length':size})
+        cursor=b+size
+    return {'OriginalBytes':len(original),'OriginalSHA256':hashlib.sha256(original).hexdigest(),
+            'OutputBytes':len(modified),'OutputSHA256':hashlib.sha256(modified).hexdigest(),
+            'Operations':operations}
+
+def apply(original, patch):
+    if len(original)!=patch['OriginalBytes'] or hashlib.sha256(original).hexdigest()!=patch['OriginalSHA256']:
+        raise ValueError('Original does not match')
+    out=bytearray()
+    for op in patch['Operations']:
+        if 'Copy' in op:
+            start,size=op['Copy'],op['Length']
+            if start<0 or size<0 or start+size>len(original):raise ValueError('Invalid copy range')
+            out.extend(original[start:start+size])
+        else:out.extend(base64.b64decode(op['Data'],validate=True))
+    if len(out)!=patch['OutputBytes'] or hashlib.sha256(out).hexdigest()!=patch['OutputSHA256']:
+        raise ValueError('Patched result does not match')
+    return bytes(out)
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__);ap.add_argument('originals',type=Path);ap.add_argument('modified',type=Path);ap.add_argument('output',type=Path)
+    args=ap.parse_args()
+    files={}
+    for name in ['tm.dat','other.dat','codes.gct']:
+        original=(args.originals/name).read_bytes();modified=(args.modified/name).read_bytes()
+        patch=recipe(original,modified)
+        if apply(original,patch)!=modified:raise ValueError('Recipe roundtrip failed')
+        files[name]=patch
+    doc={'Format':'Preflight parallel queue experimental patch 1','DolSHA256':'f604e1399f2dc88e2fbbaa2b3441867ca34d00b99b82e16bee4e4ef108604805',
+         'CodesSHA256':'1fdf6c7f11268e39d6bd68124b1b287008869f3e941851eb19b23a34dd54701d','Files':files}
+    if args.output.exists():raise ValueError('Output exists')
+    args.output.write_text(json.dumps(doc,separators=(',',':'))+'\n')
+    print('Roundtrip verified:',args.output)
+if __name__=='__main__':main()
diff --git a/Development/SingleInstance/Tools/test_ppc_dma.py b/Development/SingleInstance/Tools/test_ppc_dma.py
new file mode 100644
index 0000000..cd5caf9
--- /dev/null
+++ b/Development/SingleInstance/Tools/test_ppc_dma.py
@@ -0,0 +1,203 @@
+#!/usr/bin/env python3
+"""Run compiled adapters through upstream Slippi EXI transfer AND the supplied
+DOL's actual EXIDma instructions. Other SDK services and the host queue remain
+mocked. This specifically exercises address masking missing from earlier tests.
+Requires original analysis files locally, never bundles their game code.
+"""
+import argparse, hashlib, struct
+from pathlib import Path
+from types import SimpleNamespace
+from unicorn import UC_HOOK_MEM_WRITE
+from unicorn import ppc_const as P
+import test_ppc_hooks as hooks
+
+class DmaMachine(hooks.Machine):
+    def __init__(self,name,original,obj,dol,boot,base=0x81000000):
+        self.dma=[];self.requests=[];self.invalid_frames=[]
+        super().__init__(name,original,obj,base=base)
+        transfer=None;cursor=8
+        while cursor+8<=len(boot):
+            op,count=struct.unpack_from('>II',boot,cursor);cursor+=8
+            if op>>24==0xc2:
+                body=boot[cursor:cursor+count*8];cursor+=count*8
+                if op&0xffffff==0x55f0:transfer=body
+            elif op>>24==6:cursor+=(count+7)//8*8
+            elif op>>24==0xf0:break
+        if transfer is None:raise ValueError('Missing Slippi EXI transfer routine')
+        self.u.mem_write(0x80500000,transfer)
+        for i in range(18):
+            offset,address,size=[struct.unpack_from('>I',dol,n+i*4)[0] for n in (0,0x48,0x90)]
+            if address<=0x80345e60<address+size:
+                self.u.mem_write(0x80345e60,dol[offset+0x80345e60-address:offset+0x80345f4c-address])
+                break
+        else:raise ValueError('Missing EXIDma')
+        self.u.mem_map(0xcc006000,0x2000)
+        self.u.mem_write(0x804a7ccc,struct.pack('>I',4)) # Channel 1 selected, idle
+        self.u.hook_add(UC_HOOK_MEM_WRITE,self.mmio)
+    def mmio(self,u,access,address,size,value,user):
+        if address!=0xcc006820:return
+        # These registers are written by the actual DOL SDK instructions.
+        physical=struct.unpack('>I',u.mem_read(0xcc006818,4))[0]
+        length=struct.unpack('>I',u.mem_read(0xcc00681c,4))[0]
+        target=0x80000000|physical;write=(value>>2)&1
+        requested=self.requests[-1]
+        self.dma.append((requested[0],target,length,write))
+        if write:
+            frame=bytes(u.mem_read(target,length))
+            self.transfer_write(frame)
+        else:u.mem_write(target,self.rx.ljust(length,b'\0')[:length])
+    def transfer_write(self,frame):
+        if len(frame)==13 and frame[:6]==b'\xe6PFDQ\x01':self.rx=self.control(frame)
+        elif frame==b'\xba':self.actions.append('cleanup');self.foreground=255
+        else:self.invalid_frames.append(frame);self.rx=b'\0'*16
+    def hook(self,u,address,size,user):
+        if address==0x800055f0:
+            self.requests.append((u.reg_read(P.UC_PPC_REG_3),u.reg_read(P.UC_PPC_REG_4),u.reg_read(P.UC_PPC_REG_5)))
+            u.reg_write(P.UC_PPC_REG_PC,0x80500000);return
+        # Execute EXIDma itself. Mock only interrupt/lock/select/sync services.
+        if address in (0x80347364,0x8034738c,0x803464c0,0x80346d80,0x80346688,
+                       0x80345f4c,0x803467b4,0x80346e74,0x803465cc):
+            if address==0x80345f4c:u.mem_write(0x804a7ccc,struct.pack('>I',4))
+            u.reg_write(P.UC_PPC_REG_3,1);self.ret();return
+        super().hook(u,address,size,user)
+
+class OriginalLRMachine(DmaMachine):
+    """Also execute Preflight's original entry/L+R/exit code, not mock them."""
+    def __init__(self,*args,**kwargs):
+        self.registered=[]
+        super().__init__(*args,**kwargs)
+        # Scene descriptor -> minor descriptor -> original scene-decision slot.
+        self.write(0x80560001,b'\x08')
+        self.write(0x80560010,struct.pack('>I',0x80560100))
+        self.write(0x80560100,b'\x00')
+        self.write(0x80560118,b'\xff')
+        self.write(0x80560108,struct.pack('>I',0x80571000))
+        self.write(0x804a0bd0,struct.pack('>I',0x80580000))
+        self.write(0x803f0e0b,b'\x02')
+        self.write(0x803f0e09,b'\x01')
+        self.write(0x803f0b25+2*28,b'\x02')
+    def hook(self,u,address,size,user):
+        if address in (self.base,self.base+0xe8,self.base+0x208):return
+        if address==0x801a50ac:
+            u.reg_write(P.UC_PPC_REG_3,0x80560000);self.ret();return
+        if address==0x803901f0:
+            u.reg_write(P.UC_PPC_REG_3,0x80560200);self.ret();return
+        if address==0x8038fd54:
+            self.registered.append(u.reg_read(P.UC_PPC_REG_4));self.ret();return
+        if address in (0x8038cff4,0x80380580,0x80571000):
+            if address==0x80571000:self.actions.append('original_decide')
+            u.reg_write(P.UC_PPC_REG_3,0);self.ret();return
+        super().hook(u,address,size,user)
+
+class OriginalQueueMachine(DmaMachine):
+    """Execute Aitch's existing queue/cancel callbacks after our interception."""
+    def __init__(self,*args,**kwargs):
+        self.search_modes=[];self.selection_packets=[]
+        super().__init__(*args,**kwargs)
+        for offset,target in [(0xc520,0x805e0000),(0xc51c,0x805e0040),(0xc510,0x805e0080)]:
+            self.write(self.base+offset,struct.pack('>I',target))
+        self.write(0x805e0000,bytes([0xb5,0,2,1,1,0,31,3,3,0]))
+        self.write(0x805e0040,bytes([0xb4,3])+b'EC@918'+b'\0'*12)
+        self.write(0x805e012c,struct.pack('>I',0x805e0200))
+    def transfer_write(self,frame):
+        if len(frame)==10 and frame[0]==0xb5:self.selection_packets.append(frame)
+        elif len(frame)==20 and frame[0]==0xb4:
+            self.foreground=frame[1];self.search_modes.append(frame[1])
+        else:super().transfer_write(frame)
+    def hook(self,u,address,size,user):
+        if address in [self.base+n for n in [0x4884,0x4588,0x4660,0x4390]]:return
+        if address in [0x802f33cc,0x801a4674]:self.ret();return
+        if address==0x80034110:
+            u.reg_write(P.UC_PPC_REG_3,0x805e0100);self.ret();return
+        super().hook(u,address,size,user)
+    def start_team_search(self):
+        self.arm()
+        self.write(self.base+0xc1c8,struct.pack('>I',1))
+        for delta,value in [(20,1),(32,0x324632c8),(36,0x50ff46ff),(40,0)]:
+            self.write(self.base+0x9fbc+delta,struct.pack('>I',value))
+    def click(self,offset):self.run(self.read32(self.base+offset+12),self.base+offset)
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--originals',type=Path,required=True);ap.add_argument('--objects',type=Path,required=True)
+    ap.add_argument('--old-objects',type=Path);ap.add_argument('--dol',type=Path,required=True)
+    ap.add_argument('--bootloader',type=Path,default=Path(__file__).resolve().parents[3]/'Data/Sys/bootloader.gct')
+    args=ap.parse_args();dol=args.dol.read_bytes();boot=args.bootloader.read_bytes()
+    if hashlib.sha256(dol).hexdigest()!='f604e1399f2dc88e2fbbaa2b3441867ca34d00b99b82e16bee4e4ef108604805':
+        raise ValueError('Use the exact supported supplied DOL')
+    if args.old_objects:
+        hooks.args=SimpleNamespace(objects=args.old_objects)
+        old=DmaMachine('other.dat',(args.originals/'other.dat').read_bytes(),(args.old_objects/'other-hooks.o').read_bytes(),dol,boot)
+        failure=None
+        try:old.run('PFQ_Entry')
+        except Exception as error:failure=str(error)
+        hooks.check(any(requested!=actual for requested,actual,_,_ in old.dma),'old code reproduces DMA rounding away from its stack buffers')
+        print('Old adapter:',[(hex(a),hex(b),n,w) for a,b,n,w in old.dma], 'invalid frames:',len(old.invalid_frames),'return:',failure)
+    hooks.args=SimpleNamespace(objects=args.objects)
+    transfers=0
+    for name in ['tm.dat','other.dat']:
+        for shift in range(0,32,4):
+            for stack in [0x817e0000,0x817e0010]:
+                m=DmaMachine(name,(args.originals/name).read_bytes(),(args.objects/(name[:-4]+'-hooks.o')).read_bytes(),dol,boot,base=0x81000000+shift)
+                m.run('PFQ_Entry',stack_top=stack)
+                if name=='tm.dat':
+                    hooks.check(m.read32(m.base+0xc494)==5,'actual DMA probe retains original root')
+                    m.arm()
+                    m.run('PFQ_PlaySingles',m.base+0x9f64,stack_top=stack)
+                    hooks.check(m.parked and m.foreground==1,'actual DMA retains armed Teams during Unranked dispatch')
+                    m.waiting=False;m.connected=True;m.run('PFQ_Frame',0x81700000,stack_top=stack)
+                    hooks.check(m.parked and 'cleanup' in m.actions,'cleanup is aligned and leaves background parked')
+                else:
+                    m.parked=True;m.connected=True;m.token=17;m.foreground=1;m.write(0x804d6640,b'\x01')
+                    m.run('PFQ_Frame',0x81700000,stack_top=stack)
+                    hooks.check(m.parked and 'cleanup' in m.actions,'CSS cleanup uses actual aligned DMA')
+                hooks.check(not m.invalid_frames,'all commands retain correct wire framing after DMA masking')
+                hooks.check(all(requested==actual and actual%32==0 for requested,actual,_,_ in m.dma),'every DMA targets the exact requested aligned buffer')
+                hooks.check(all(not 0x817c0000<=actual<0x817f0000 for _,actual,_,_ in m.dma),'DMA buffers cannot overlap the caller stack')
+                transfers+=len(m.dma)
+    for shift,stack in [(0,0x817e0000),(4,0x817e0010)]:
+        m=OriginalLRMachine('other.dat',(args.originals/'other.dat').read_bytes(),(args.objects/'other-hooks.o').read_bytes(),dol,boot,base=0x81000000+shift)
+        m.run('PFQ_Entry',stack_top=stack)
+        hooks.check(m.registered==[m.symbols['PFQ_Frame']],'real original entry registers wrapped frame callback')
+        hooks.check(m.read32(0x80560108)==m.symbols['PFQ_OnExit'],'real original entry installs wrapped exit callback')
+        m.run('PFQ_Frame',0x80560200,stack_top=stack) # Release initial held-button guard
+        m.write(0x804c1fac,struct.pack('>I',0x60)) # Digital L+R, controller 1
+        m.run('PFQ_Frame',0x80560200,stack_top=stack)
+        hooks.check(m.u.mem_read(m.base+0x380,1)==b'\x01','real original L+R callback marks training exit')
+        m.run('PFQ_OnExit',stack_top=stack)
+        hooks.check(('next_major',0x1c) in m.actions,'real original scene-exit code selects training')
+        hooks.check(m.read32(0x80560108)==0x80571000,'real original exit restores original scene callback')
+        hooks.check(m.u.mem_read(0x804d65bc,1)==b'\x01' and m.u.mem_read(0x8045b438,1)==b'\x02','real original exit preserves character-selection entry path')
+        hooks.check(not m.invalid_frames and all(a==b for a,b,_,_ in m.dma),'real L+R route retains safe DMA targets')
+        transfers+=len(m.dma)
+    for shift in [0,4,28]:
+        def queue_machine():
+            obj=OriginalQueueMachine('tm.dat',(args.originals/'tm.dat').read_bytes(),(args.objects/'tm-hooks.o').read_bytes(),dol,boot,base=0x81000000+shift)
+            obj.run('PFQ_Entry');return obj
+        m=queue_machine();m.foreground=255;m.click(0x9fbc)
+        hooks.check(m.read32(m.base+0xc1e0)==m.base+0xc388 and not m.parked,'ordinary Teams button opens original team/color interface without a background search')
+        m=queue_machine();m.start_team_search();m.click(0x9f64)
+        hooks.check(m.parked and m.foreground==1 and m.calls.count(1)==0,'real ordinary Unranked callback starts singles after one Teams park')
+        hooks.check(m.search_modes==[1] and len(m.selection_packets)==1,'real Unranked callback sends ordinary selections and search commands')
+        hooks.check(m.read32(m.base+0x9fbc+36)==0xffce46ff and m.read32(m.base+0x9f64+36)==0x50ff46ff,'armed Teams remains yellow while singles is green after original cleanup')
+        hooks.check(m.read32(m.base+0x9f44)==m.base+0x4884 and m.read32(m.base+0x9ff4)==m.base+0x4884,'Ranked/Party callbacks are unchanged')
+        m.click(0x9f90)
+        hooks.check(m.parked and m.foreground==255 and m.calls.count(1)==0,'real Direct callback preserves existing background through its cleanup')
+        hooks.check(m.read32(m.base+0xc1e0)==m.base+0xc308,'real Direct code-entry interface opens')
+        hooks.check(m.search_modes==[1],'Direct waits for code confirmation before searching')
+        m.click(0x9f64)
+        hooks.check(m.parked and m.foreground==1,'Unranked can restart while Teams remains queued')
+        m.click(0x9fbc)
+        hooks.check(not m.parked and m.foreground==1 and m.read32(m.base+0x9f64+20)==1,'ordinary Teams button cancels background only and keeps Unranked active')
+        hooks.check(m.read32(m.base+0x9fbc+36)==0,'Teams outline clears after actual background cancellation')
+        m=queue_machine();m.start_team_search();m.click(0x9f64);m.click(0x9f64)
+        hooks.check(m.parked and m.foreground==255 and m.read32(m.base+0x9f64+20)==0 and m.read32(m.base+0x9fbc+20)==1,'toggling Unranked off leaves background Teams highlighted')
+        m=queue_machine();m.foreground=255;m.click(0x9f64)
+        hooks.check(not m.parked and m.foreground==1 and 1 not in m.calls,'Unranked works normally without a Teams search')
+        m=queue_machine();m.start_team_search();m.click(0x9f64);m.failed=True;m.run('PFQ_Frame',m.base+0xc288)
+        hooks.check(m.read32(m.base+0x9fbc+36)==0xff5050ff,'failed background changes indicator to red')
+        hooks.check(not any(isinstance(action,tuple) and action[0]=='exit_minor' for action in m.actions),'failed background never requests a takeover')
+        hooks.check(not m.invalid_frames and all(a==b for a,b,_,_ in m.dma),'real callbacks and wrappers retain aligned DMA')
+        transfers+=len(m.dma)
+    print(hooks.checks,'real-DMA adapter checks passed across',transfers,'transfers, 8 module alignments and 2 stack alignments. SDK services/host queue mocked; no full Dolphin or live matchmaking ran.')
+if __name__=='__main__':main()
