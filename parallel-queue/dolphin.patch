@@ -0,0 +1,27 @@
+// Copyright 2026 Dolphin Emulator Project. Licensed under GPLv2+.
+#include "Core/Slippi/SlippiRustAccess.h"
+#include <atomic>
+#include <iostream>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+int checks=0;
+void Check(bool v,const char* why){if(!v)throw std::runtime_error(why);++checks;}
+int main()
+{
+  SlippiRustAccess device;auto user=device;auto codes=device;auto matchmaking=device;
+  std::atomic<int> entered{0},overlap{0},total{0};
+  std::vector<std::thread> workers;
+  for(int i=0;i<8;++i)workers.emplace_back([&,i]{
+    auto access=i%3==0?user:i%3==1?codes:matchmaking;
+    for(int n=0;n<2000;++n)access.Call([&]{if(entered.fetch_add(1)!=0)++overlap;++total;entered.fetch_sub(1);});
+  });
+  for(auto& worker:workers)worker.join();
+  Check(total.load()==16000,"all opaque-device operations completed");
+  Check(overlap.load()==0,"copied gates never concurrently enter the same Rust device");
+  Check(device.Call([&]{return user.Call([]{return 42;});})==42,"same-thread nested FFI operations do not deadlock");
+  bool threw=false;try{device.Call([]()->void{throw std::runtime_error("test");});}catch(const std::runtime_error&){threw=true;}
+  Check(threw,"FFI wrapper preserves exceptions");
+  Check(device.Call([]{return 7;})==7,"exception releases device access");
+  std::cout<<checks<<" Rust device access checks passed, including 16000 competing operations. No Rust runtime was run.\n";
+}
