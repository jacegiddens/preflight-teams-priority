+/* Copyright 2026 Dolphin Emulator Project. Licensed under GPLv2+. */
+#ifndef PREFLIGHT_QUEUE_CLIENT_H
+#define PREFLIGHT_QUEUE_CLIENT_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Same call shape as Slippi's existing EXI transfer routine. */
+typedef void (*PFQ_Transfer)(void *buffer, uint32_t length, uint8_t write);
+typedef struct { PFQ_Transfer transfer; uint8_t available; } PFQ_Client;
+typedef struct {
+    uint8_t result, flags, foreground_mode;
+    uint32_t generation, capabilities;
+} PFQ_Reply;
+enum { PFQ_CAPABILITIES = 0, PFQ_PARK_TEAMS = 1, PFQ_STATUS = 2,
+       PFQ_ACTIVATE_TEAMS = 3, PFQ_CANCEL_TEAMS = 4 };
+enum { PFQ_OK = 0, PFQ_UNAVAILABLE = -1 };
+void PFQ_Init(PFQ_Client *client, PFQ_Transfer transfer);
+int PFQ_Probe(PFQ_Client *client, PFQ_Reply *reply);
+int PFQ_Call(PFQ_Client *client, uint8_t operation, uint32_t generation, PFQ_Reply *reply);
+#ifdef __cplusplus
+}
+#endif
+#endif
