diff --git a/Source/Core/Core/Slippi/SlippiActiveClient.h b/Source/Core/Core/Slippi/SlippiActiveClient.h
new file mode 100644
index 0000000..aa8043b
--- /dev/null
+++ b/Source/Core/Core/Slippi/SlippiActiveClient.h
@@ -0,0 +1,39 @@
+// Copyright 2026 Dolphin Emulator Project
+// Licensed under GPLv2+
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <atomic>
+
+// This is an identity marker, not ownership of a client. A pending background
+// connection must not become the gameplay client merely by being constructed.
+// Destruction/disconnect may only release the marker owned by that client.
+// No caller obtains or dereferences a pointer from this registry.
+template <typename Client>
+class SlippiActiveClient
+{
+public:
+  void Activate(Client* client)
+  {
+    m_client.store(client, std::memory_order_release);
+  }
+
+  void Release(Client* client)
+  {
+    m_client.compare_exchange_strong(client, nullptr, std::memory_order_acq_rel);
+  }
+
+  bool IsOnline() const
+  {
+    return m_client.load(std::memory_order_acquire) != nullptr;
+  }
+
+  bool IsActive(const Client* client) const
+  {
+    return m_client.load(std::memory_order_acquire) == client;
+  }
+
+private:
+  std::atomic<Client*> m_client{nullptr};
+};
