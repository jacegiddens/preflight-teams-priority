@@ -0,0 +1,63 @@
+// Copyright 2026 Dolphin Emulator Project. Licensed under GPLv2+.
+#include "Core/Slippi/SlippiQueueControl.h"
+#include "Game/queue_client.h"
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+
+using Q = SlippiQueueControl;
+struct Backend : Q::Backend
+{
+  bool present=false, ready=false, busy=false;
+  Q::Mode mode=Q::Mode::Teams;
+  Q::Mode ForegroundMode() const override {return mode;}
+  bool ForegroundBusy() const override {return busy;}
+  bool CanParkTeams() const override {return true;}
+  bool HasTeams() const override {return present;}
+  bool TeamsReady() const override {return ready;}
+  bool TeamsFailed() const override {return false;}
+  void ParkTeams() override {present=true;mode=Q::Mode::None;}
+  void ActivateTeams() override {present=false;mode=Q::Mode::Teams;}
+  void CancelTeams() override {present=false;}
+} backend;
+Q host;
+Q::Reply response{};
+std::array<std::uint8_t,13> last_request{};
+bool stock=false;
+int writes=0, checks=0;
+void Check(bool v,const char* reason){if(!v)throw std::runtime_error(reason);++checks;}
+void Transfer(void* data,std::uint32_t length,std::uint8_t write)
+{
+  if(write)
+  {
+    if(length!=13||static_cast<std::uint8_t*>(data)[0]!=Q::Command)throw std::runtime_error("incorrect EXI request framing");
+    std::memcpy(last_request.data(),data,length);++writes;
+    response=stock?Q::Reply{}:host.Handle(last_request.data()+1,12,backend);
+  }
+  else
+  {
+    if(length!=16)throw std::runtime_error("incorrect EXI response length");
+    std::memcpy(data,response.data(),16);
+  }
+}
+int main()
+{
+  PFQ_Client client;PFQ_Reply reply{};PFQ_Init(&client,Transfer);
+  Check(PFQ_Call(&client,PFQ_PARK_TEAMS,0,&reply)==PFQ_UNAVAILABLE&&writes==0,"unprobed host cannot receive park request");
+  reply.flags=3;reply.generation=99;
+  stock=true;Check(PFQ_Probe(&client,&reply)==PFQ_UNAVAILABLE&&!client.available,"stock/no-capability host disables extension");
+  Check(reply.flags==0&&reply.generation==0,"failed probe clears stale ready status");
+  int before=writes;Check(PFQ_Call(&client,PFQ_PARK_TEAMS,0,&reply)==PFQ_UNAVAILABLE&&writes==before,"failed probe cannot fall through to park");
+  stock=false;Check(PFQ_Probe(&client,&reply)==PFQ_OK&&client.available&&reply.capabilities==15,"C game client discovers C++ host capabilities");
+  Check(PFQ_Call(&client,PFQ_PARK_TEAMS,0,&reply)==PFQ_OK&&backend.present&&reply.generation!=0,"cross-language park and generation decoding");
+  auto generation=reply.generation;
+  Check(PFQ_Call(&client,PFQ_ACTIVATE_TEAMS,0x01020304,&reply)==static_cast<int>(Q::Result::StaleGeneration),"invalid generation rejected by real host parser");
+  Check(last_request[9]==1&&last_request[10]==2&&last_request[11]==3&&last_request[12]==4,"wire generation uses big-endian bytes on either host architecture");
+  backend.ready=true;backend.busy=true;
+  Check(PFQ_Call(&client,PFQ_STATUS,0,&reply)==PFQ_OK&&(reply.flags&3)==3,"ready state visible without switching game");
+  Check(PFQ_Call(&client,PFQ_ACTIVATE_TEAMS,generation,&reply)==static_cast<int>(Q::Result::Busy)&&backend.present,"caller cannot bypass live-game guard");
+  backend.busy=false;Check(PFQ_Call(&client,PFQ_ACTIVATE_TEAMS,generation,&reply)==PFQ_OK&&!backend.present,"safe handoff completed through actual C/C++ wire contract");
+  Check(PFQ_Call(&client,PFQ_CANCEL_TEAMS,generation,&reply)==static_cast<int>(Q::Result::StaleGeneration),"old cancellation cannot affect activated Teams");
+  std::cout<<checks<<" C game-client / C++ host protocol integration checks passed. No game or network ran.\n";
+}
