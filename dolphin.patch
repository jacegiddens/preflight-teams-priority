@@ -0,0 +1,171 @@
+/* Copyright 2026 Dolphin Emulator Project. Licensed under GPLv2+.
+ * Adapter for the exact supplied Preflight v1.1 modules. The patch builder
+ * resolves these imports using verified module offsets, never a runtime base.
+ * EXPERIMENTAL: static and protocol tests do not establish game compatibility.
+ */
+#include "queue_client.h"
+
+typedef struct MenuRow {
+    const char *name, *value;
+    uint32_t inline_value;
+    void (*press)(struct MenuRow *), (*adjust)(struct MenuRow *);
+    uint32_t state, argument;
+    void *context;
+    uint32_t colors[3];
+} MenuRow;
+extern void Slippi_EXI_Transfer(void *, uint32_t, uint8_t);
+extern void Scene_ExitMinor(void), Scene_SetNextMinor(int), Scene_SetNextMajor(int), Scene_CommitMajor(void);
+extern volatile uint8_t scene_info[], online_mode, chose_stage;
+static PFQ_Client client;
+static PFQ_Reply reply;
+
+static int query(void) { return PFQ_Call(&client, PFQ_STATUS, 0, &reply); }
+static int ready(void) { return (reply.flags & 7) == 3; }
+static void cleanup(void)
+{
+    PFQ_CleanupForeground(&client);
+}
+static void probe(void)
+{
+    PFQ_Init(&client, Slippi_EXI_Transfer);
+    PFQ_Probe(&client, &reply);
+}
+
+#ifdef PFQ_PRACTICE
+extern void Original_Entry(void), Original_Frame(void *);
+extern void Original_Unranked(MenuRow *), Original_Direct(MenuRow *), Original_Teams(MenuRow *);
+extern MenuRow queue_unranked_row, queue_direct_row, queue_teams_row;
+extern const char original_teams_label[];
+static uint8_t displayed_background;
+
+static void sync_teams_indicator(void)
+{
+    MenuRow *row = &queue_teams_row;
+    if (reply.flags & 1) {
+        displayed_background = 1;
+        row->state = 1;
+        row->name = (reply.flags & 4) ? "Teams Failed" :
+                    (reply.flags & 2) ? "Teams Ready" :
+                    (reply.flags & 8) ? "Teams Armed" :
+                    (reply.flags & 16) ? "Teams Searching" : "Teams Starting";
+        row->colors[0] = (reply.flags & 4) ? 0x643232c8u :
+                         (reply.flags & 18) ? 0x324632c8u : 0x645432c8u;
+        row->colors[1] = (reply.flags & 4) ? 0xff5050ffu :
+                         (reply.flags & 18) ? 0x50ff46ffu : 0xffce46ffu;
+        row->colors[2] = 0;
+    } else if (displayed_background) {
+        displayed_background = 0;
+        row->name = original_teams_label;
+        row->state = 0;
+        row->colors[0] = row->colors[1] = row->colors[2] = 0;
+    }
+}
+extern uint32_t root_row_count, queue_counter;
+extern uint8_t exit_to_slippi;
+
+static void leave_practice(void)
+{
+    cleanup();
+    online_mode = 3;
+    queue_counter = 0;
+    exit_to_slippi = 1;
+    Scene_ExitMinor();
+}
+void PFQ_Entry(void)
+{
+    Original_Entry();
+    if (scene_info[0] != 0x1c || scene_info[3] != 2) return;
+    displayed_background = 0;
+    probe();
+    root_row_count = 5;
+    if (client.available) sync_teams_indicator();
+}
+void PFQ_PlaySingles(MenuRow *row)
+{
+    MenuRow *canonical = row->argument == 1 ? &queue_unranked_row : &queue_direct_row;
+    if (query() == PFQ_OK) {
+        if (ready()) { leave_practice(); return; }
+
+    }
+    row->value = 0;
+    canonical->value = 0;
+    if (row->argument == 1) Original_Unranked(canonical);
+    else Original_Direct(canonical);
+    /* Original cleanup clears all queue outlines. Restore the Teams outline
+       only from the emulator's retained-background status, never from a guess. */
+    if (query() == PFQ_OK) sync_teams_indicator();
+}
+void PFQ_QueueTeams(MenuRow *row)
+{
+    if (query() == PFQ_OK && (reply.flags & 1)) {
+        if (PFQ_Call(&client, PFQ_CANCEL_TEAMS, reply.generation, &reply) == PFQ_OK)
+            sync_teams_indicator();
+        return;
+    }
+    Original_Teams(row);
+}
+void PFQ_CancelTeams(MenuRow *row)
+{
+    /* This long action label has no room for a right-aligned value. The
+       ordinary Teams row already confirms cancellation by losing its outline.
+       Keep both successful cancellation and the no-search case value-free. */
+    row->value = 0;
+    if (query() != PFQ_OK) return;
+    if (!(reply.flags & 1)) return;
+    if (PFQ_Call(&client, PFQ_CANCEL_TEAMS, reply.generation, &reply) == PFQ_OK) {
+        sync_teams_indicator();
+    }
+}
+void PFQ_Frame(void *object)
+{
+    if (query() == PFQ_OK) {
+        sync_teams_indicator();
+        if (ready()) { leave_practice(); return; }
+    }
+    Original_Frame(object);
+}
+#else
+extern void Original_Entry(void), Original_Frame(void *), Original_OnExit(void);
+extern uint8_t lr_exit;
+/* 1: restart CSS in Teams mode before activating; 2: wait for the previous
+   report/replay to drain; 3: handoff completed. Reset on each scene entry. */
+static uint8_t phase;
+void PFQ_Entry(void)
+{
+    phase = 0;
+    lr_exit = 0;
+    Original_Entry();
+    probe();
+}
+void PFQ_OnExit(void)
+{
+    Original_OnExit();
+    if (phase != 1) return;
+    /* Original_OnExit first restores Preflight's original scene callback and
+       runs ordinary Slippi cleanup. Re-enter a fresh Teams CSS afterwards. */
+    Scene_SetNextMinor(0);
+    Scene_SetNextMajor(8);
+    Scene_CommitMajor();
+}
+void PFQ_Frame(void *object)
+{
+    if (scene_info[0] == 8 && scene_info[3] == 0 && query() == PFQ_OK && ready()) {
+        if (online_mode != 3) {
+            if (phase != 1) {
+                cleanup();
+                online_mode = 3;
+                phase = 1;
+                Scene_ExitMinor();
+            }
+            return;
+        }
+        if (phase != 2) { cleanup(); phase = 2; }
+        if (PFQ_Call(&client, PFQ_ACTIVATE_TEAMS, reply.generation, &reply) == PFQ_OK) {
+            chose_stage = 1;
+            phase = 3;
+        }
+        return;
+    }
+    Original_Frame(object);
+}
+#endif
diff --git a/Development/SingleInstance/Game/queue_client.c b/Development/SingleInstance/Game/queue_client.c
new file mode 100644
index 0000000..e861e42
--- /dev/null
+++ b/Development/SingleInstance/Game/queue_client.c
@@ -0,0 +1,82 @@
+/* Copyright 2026 Dolphin Emulator Project. Licensed under GPLv2+. */
+#include "queue_client.h"
+
+/* The game's EXIDma routine masks the low five address bits. Keep both
+ * buffers in their own complete cache lines: an unaligned stack buffer makes
+ * DMA overwrite bytes BEFORE the requested buffer (including saved registers).
+ * Align at runtime because the archive loader chooses the module base. */
+static uint8_t dma_storage[95];
+static uint8_t *transmit_buffer(void)
+{
+    return (uint8_t *)(((uintptr_t)dma_storage + 31u) & ~(uintptr_t)31u);
+}
+static uint32_t read32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+static void clear_reply(PFQ_Reply *reply)
+{
+    if (reply) {
+        reply->result = 255; reply->flags = 0; reply->foreground_mode = 255;
+        reply->generation = 0; reply->capabilities = 0;
+    }
+}
+static int request(PFQ_Client *client, uint8_t operation, uint32_t generation, PFQ_Reply *reply)
+{
+    uint8_t *tx = transmit_buffer();
+    uint8_t *rx = tx + 32;
+    unsigned i;
+    clear_reply(reply);
+    if (!client || !client->transfer || !reply) return PFQ_UNAVAILABLE;
+    for (i = 0; i < 32; ++i) { tx[i] = 0; rx[i] = 0; }
+    tx[0] = 0xe6; tx[1] = 'P'; tx[2] = 'F'; tx[3] = 'D'; tx[4] = 'Q'; tx[5] = 1;
+    tx[6] = operation;
+    tx[9] = (uint8_t)(generation >> 24);
+    tx[10] = (uint8_t)(generation >> 16);
+    tx[11] = (uint8_t)(generation >> 8);
+    tx[12] = (uint8_t)generation;
+    client->transfer(tx, 13, 1);
+    client->transfer(rx, 16, 0);
+    if (rx[0] != 'P' || rx[1] != 'F' || rx[2] != 'D' || rx[3] != 'Q' || rx[4] != 1 ||
+        (read32(rx + 12) & 31) != 31 || rx[5] > 10 || (rx[6] & 224) != 0 ||
+        ((rx[6] & 30) != 0 && (rx[6] & 1) == 0) ||
+        ((rx[6] & 30) != 0 && ((rx[6] & 30) & ((rx[6] & 30) - 1)) != 0) ||
+        (rx[7] > 4 && rx[7] != 255))
+    {
+        client->available = 0;
+        return PFQ_UNAVAILABLE;
+    }
+    reply->result = rx[5];
+    reply->flags = rx[6];
+    reply->foreground_mode = rx[7];
+    reply->generation = read32(rx + 8);
+    reply->capabilities = read32(rx + 12);
+    return reply->result;
+}
+void PFQ_Init(PFQ_Client *client, PFQ_Transfer transfer)
+{
+    if (client) { client->transfer = transfer; client->available = 0; }
+}
+int PFQ_Probe(PFQ_Client *client, PFQ_Reply *reply)
+{
+    int result;
+    if (!client) return PFQ_UNAVAILABLE;
+    client->available = 0;
+    result = request(client, PFQ_CAPABILITIES, 0, reply);
+    if (result == PFQ_OK) client->available = 1;
+    return result;
+}
+int PFQ_Call(PFQ_Client *client, uint8_t operation, uint32_t generation, PFQ_Reply *reply)
+{
+    if (!client || !client->available) { clear_reply(reply); return PFQ_UNAVAILABLE; }
+    return request(client, operation, generation, reply);
+}
+
+void PFQ_CleanupForeground(PFQ_Client *client)
+{
+    uint8_t *tx;
+    if (!client || !client->transfer || !client->available) return;
+    tx = transmit_buffer();
+    tx[0] = 0xba;
+    client->transfer(tx, 1, 1);
+}
diff --git a/Development/SingleInstance/Game/queue_client.h b/Development/SingleInstance/Game/queue_client.h
