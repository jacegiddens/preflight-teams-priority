+#!/usr/bin/env python3
+"""Exercise repeated cancellation and Teams-menu re-entry on actual PPC code.
+
+Runs Preflight's original menu stack, input aggregation and context updates,
+plus our compiled hooks. Skips the physics tail of Practice_MainThink. Rendering,
+SDK services and the matchmaking backend are mocked; this cannot reproduce a
+full Dolphin graphics/thread/network failure. Requires private original modules
+locally, never distributes their code.
+"""
+import argparse
+from pathlib import Path
+from types import SimpleNamespace
+from unicorn import ppc_const as P
+import test_ppc_hooks as hooks
+from test_ppc_dma import OriginalQueueMachine
+
+
+class MenuMachine(OriginalQueueMachine):
+    def hook(self, u, address, size, user):
+        if address == self.base + 0x4b78:
+            # All context updates have returned. Execute the real epilogue;
+            # the remainder manipulates fighters/physics outside this test.
+            u.reg_write(P.UC_PPC_REG_PC, self.base + 0x4ba4)
+            return
+        if address in (0x8038cff4, 0x802f3394, 0x801a4634):
+            self.ret()
+            return
+        super().hook(u, address, size, user)
+
+    def init_menus(self):
+        self.run('PFQ_Entry')
+        self.u.reg_write(P.UC_PPC_REG_MSR, self.u.reg_read(P.UC_PPC_REG_MSR) | 0x2000)
+        self.write(self.base + 0xc1e4, hooks.w32(0))
+        self.write(self.base + 0xc1e8, hooks.w32(self.base + 0xc488))
+        self.write(self.base + 0xc50c, b'\x01')
+        # Reproduce the list links from Original_Entry; its other scene/asset
+        # setup is mocked by the shared adapter harness.
+        for at, nxt in [(0xc208, 0xc288), (0xc288, 0xc308), (0xc308, 0xc388),
+                        (0xc388, 0xc408), (0xc408, 0xc488)]:
+            self.write(self.base + at, hooks.w32(self.base + nxt))
+
+    def active(self):
+        depth = self.read32(self.base + 0xc1e4)
+        hooks.check(depth < 8, 'menu stack remains within its original eight slots')
+        return self.read32(self.base + 0xc1e8 + 4 * depth)
+
+    def frame(self, buttons=0):
+        # Port 1 held/pressed records consumed by the original MainThink code.
+        self.write(0x804c1fac, hooks.w32(buttons))
+        self.write(0x804c1fb4, hooks.w32(buttons))
+        self.run(self.base + 0x4a1c)
+
+    def select(self, index):
+        self.write(self.active() + 24, hooks.w32(index))
+        self.frame(0x100)  # A
+        self.frame()      # Release; process pending menu-stack transition.
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--originals', type=Path, required=True)
+    ap.add_argument('--objects', type=Path, required=True)
+    ap.add_argument('--dol', type=Path, required=True)
+    ap.add_argument('--cycles', type=int, default=20)
+    args = ap.parse_args()
+    if args.cycles < 1:
+        ap.error('cycles must be positive')
+    hooks.args = SimpleNamespace(objects=args.objects)
+    bootloader = Path(__file__).resolve().parents[3] / 'Data/Sys/bootloader.gct'
+    m = MenuMachine('tm.dat', (args.originals / 'tm.dat').read_bytes(),
+                    (args.objects / 'tm-hooks.o').read_bytes(), args.dol.read_bytes(),
+                    bootloader.read_bytes())
+    m.init_menus()
+    for _ in range(args.cycles):
+        m.select(0)
+        hooks.check(m.active() == m.base + 0xc408, 'original Queue opens with five-root layout')
+        for _ in range(10):
+            m.start_team_search()
+            m.run('PFQ_Frame',m.base+0xc288)
+            m.select(3)
+            hooks.check(not m.parked, 'original Teams row cancels armed configuration')
+            m.select(3)
+            hooks.check(m.active()==m.base+0xc388,'Teams color menu reopens after cancellation')
+            m.frame(0x200);m.frame()
+            hooks.check(m.active()==m.base+0xc408,'Back restores Queue without duplicate submenu')
+        m.frame(0x200);m.frame()
+        hooks.check(m.active()==m.base+0xc488,'Back restores original general menu')
+    print(f'{args.cycles} repeated-cancel / reopen-Teams cycles passed; '
+          f'{args.cycles * 10} cancellation presses; {hooks.checks} checks. '
+          'Original menu stack/input/update instructions executed. '
+          'No full Dolphin, rendering, SDK or live matchmaking ran.')
+
+
+if __name__ == '__main__':
+    main()
