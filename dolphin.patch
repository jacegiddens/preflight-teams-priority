+#!/usr/bin/env python3
+"""Execute compiled big-endian PowerPC adapters with mocked game/EXI services.
+This is an adapter regression test, not a Dolphin or live-match test.
+"""
+import argparse
+import struct
+import sys
+from pathlib import Path
+from elftools.elf.elffile import ELFFile
+from unicorn import Uc, UC_ARCH_PPC, UC_MODE_32, UC_MODE_BIG_ENDIAN, UC_HOOK_CODE
+from unicorn import ppc_const as PPC
+from analyze_preflight import Module
+from build_preflight_modules import build, HASHES
+
+checks=0
+def check(value, why):
+    global checks
+    if not value: raise AssertionError(why)
+    checks+=1
+
+def w32(value): return struct.pack('>I', value)
+
+class Machine:
+    def __init__(self, name, original, obj, stock=False, base=0x81000000):
+        self.name=name;self.base=base
+        self.module=Module(build(name,original,obj))
+        self.u=Uc(UC_ARCH_PPC,UC_MODE_32|UC_MODE_BIG_ENDIAN)
+        self.u.mem_map(0x80000000,0x1800000)
+        self.u.mem_write(self.base,self.module.relocated(self.base))
+        self.stock=stock;self.foreground=3;self.parked=False;self.connected=False
+        self.waiting=False;self.searching=False;self.busy=False;self.failed=False;self.token=0;self.tx=b'';self.rx=b''
+        self.calls=[];self.actions=[];self.old_frames=0;self.selected=[]
+        self.symbols={}
+        with open(obj_path(name),'rb') as f:
+            elf=ELFFile(f)
+            for s in elf.get_section_by_name('.symtab').iter_symbols():
+                if s.name.startswith('PFQ_') and isinstance(s['st_shndx'],int):
+                    self.symbols[s.name]=self.base+len(Module(original).code)+s['st_value']
+        self.u.hook_add(UC_HOOK_CODE,self.hook)
+        self.scene(0x1c,2) if name=='tm.dat' else self.scene(8,0)
+        self.write(0x804d6640,b'\x03')
+    def write(self,at,data): self.u.mem_write(at,data)
+    def read32(self,at): return struct.unpack('>I',self.u.mem_read(at,4))[0]
+    def scene(self,major,minor):self.write(0x80479d30,bytes([major,0,0,minor]))
+    def ret(self):self.u.reg_write(PPC.UC_PPC_REG_PC,self.u.reg_read(PPC.UC_PPC_REG_LR))
+    def control(self,tx):
+        op=tx[6];generation=int.from_bytes(tx[9:13],'big');result=0
+        self.calls.append(op)
+        if op==1:
+            if self.parked:result=6
+            elif self.foreground!=3:result=7
+            elif self.busy:result=8
+            else:self.parked=True;self.foreground=255;self.token+=1
+        if op in (3,4):
+            if generation!=self.token or not generation:result=4
+            elif not self.parked:result=5
+            elif op==3 and self.busy:result=8
+            elif op==3 and not self.connected:result=9
+            else:
+                self.parked=False;self.token+=1
+                if op==3:self.foreground=3
+        flags=(1|(4 if self.failed else 2 if self.connected else 8 if self.waiting else 16 if self.searching else 0)) if self.parked else 0
+        return b'PFDQ'+bytes([1,result,flags,self.foreground])+w32(self.token)+w32(31)
+    def hook(self,u,at,size,userdata):
+        if at==0x817f0000:u.emu_stop();return
+        r3=u.reg_read(PPC.UC_PPC_REG_3)
+        if at==0x800055f0:
+            length=u.reg_read(PPC.UC_PPC_REG_4);write=u.reg_read(PPC.UC_PPC_REG_5)
+            if write:
+                self.tx=bytes(u.mem_read(r3,length))
+                if self.tx[:1]==b'\xe6':
+                    check(len(self.tx)==13 and self.tx[1:6]==b'PFDQ\x01','compiled PPC sends correct EXI wire bytes')
+                    self.rx=b'\0'*16 if self.stock else self.control(self.tx)
+                elif self.tx==b'\xba':
+                    self.actions.append('cleanup');self.foreground=255
+            else:
+                check(length==16,'PPC reads the complete capability/status reply')
+                u.mem_write(r3,self.rx)
+            self.ret();return
+        originals=({'entry':0x9054,'frame':0x8d40,'unranked':0x4884,'direct':0x4588}
+                   if self.name=='tm.dat' else {'entry':0x208,'frame':0,'exit':0xe8})
+        for action,offset in originals.items():
+            if at==self.base+offset:
+                self.actions.append(action)
+                if action=='entry' and self.name=='tm.dat':
+                    self.write(self.base+0xc494,w32(5));self.write(self.base+0xc1d8,w32(self.base+0xc208))
+                if action=='frame':self.old_frames+=1
+                if action in ('unranked','direct'):
+                    self.selected.append((action,r3));self.foreground=1 if action=='unranked' else 2
+                self.ret();return
+        scene_calls={0x801a4b60:'exit_minor',0x801a42a0:'next_minor',0x801a42e8:'next_major',0x801a42d4:'commit_major'}
+        if at in scene_calls:
+            self.actions.append((scene_calls[at],r3));self.ret()
+    def run(self,symbol,arg=0,stack_top=0x817e0000):
+        self.u.reg_write(PPC.UC_PPC_REG_1,stack_top)
+        self.u.reg_write(PPC.UC_PPC_REG_2,0x804df9e0)
+        self.u.reg_write(PPC.UC_PPC_REG_13,0x804db6a0)
+        self.u.reg_write(PPC.UC_PPC_REG_3,arg)
+        self.u.reg_write(PPC.UC_PPC_REG_LR,0x817f0000)
+        # Verify callee-saved registers and the stack on real PPC instructions.
+        for r in range(14,32):self.u.reg_write(getattr(PPC,'UC_PPC_REG_'+str(r)),0x12340000+r)
+        self.u.emu_start(self.symbols[symbol] if isinstance(symbol,str) else symbol,0x817f0004,count=50000)
+        check(self.u.reg_read(PPC.UC_PPC_REG_PC)==0x817f0000,'hook returned within instruction budget')
+        check(self.u.reg_read(PPC.UC_PPC_REG_1)==stack_top,'PowerPC stack restored')
+        check(all(self.u.reg_read(getattr(PPC,'UC_PPC_REG_'+str(r)))==0x12340000+r for r in range(14,32)), 'callee-saved GPRs preserved')
+    def arm(self):
+        self.parked=True;self.waiting=True;self.foreground=255;self.token+=1
+
+def obj_path(name):return str(args.objects/(name[:-4]+'-hooks.o'))
+
+def machine(name,stock=False):return Machine(name,(args.originals/name).read_bytes(),(args.objects/(name[:-4]+'-hooks.o')).read_bytes(),stock)
+
+def main():
+    for name in HASHES:
+        raw=(args.originals/name).read_bytes();obj=Path(obj_path(name)).read_bytes()
+        try:build(name,raw[:-1]+bytes([raw[-1]^1]),obj);raise AssertionError('accepted changed original')
+        except ValueError:check(True,'unknown original cannot be patched')
+    m=machine('tm.dat',stock=True);m.run('PFQ_Entry')
+    check(m.read32(m.base+0xc494)==5,'stock host cannot expose new menu')
+    m=machine('tm.dat');m.run('PFQ_Entry')
+    check(m.read32(m.base+0xc494)==5,'duplicate submenu removed: original five root rows remain')
+    check(m.read32(m.base+0xc1d8)==m.base+0xc208,'original update chain has no added submenu')
+    check(m.read32(m.base+0xc49c)==m.base+0x9e5c,'original root row array is not relocated')
+    for waiting,searching,connected,failed,label,color in [
+        (True,False,False,False,b'Teams Armed\0',0xffce46ff),
+        (False,False,False,False,b'Teams Starting\0',0xffce46ff),
+        (False,True,False,False,b'Teams Searching\0',0x50ff46ff),
+        (False,False,True,False,b'Teams Ready\0',0x50ff46ff),
+        (False,False,False,True,b'Teams Failed\0',0xff5050ff)]:
+        m=machine('tm.dat');m.run('PFQ_Entry');m.arm()
+        m.waiting=waiting;m.searching=searching;m.connected=connected;m.failed=failed
+        m.run('PFQ_Frame',0x81700000)
+        name=m.read32(m.base+0x9fbc)
+        check(bytes(m.u.mem_read(name,len(label)))==label,'UI displays actual distinct queue state')
+        check(m.read32(m.base+0x9fbc+36)==color,'only searching/ready are green; waiting is yellow and error red')
+        if not connected:check(m.old_frames==1,'waiting/searching/failure do not trigger scene exit')
+    for offset,mode in [(0x9f64,1),(0x9f90,2)]:
+        m=machine('tm.dat');m.run('PFQ_Entry');m.arm()
+        m.run(m.read32(m.base+offset+12),m.base+offset)
+        check(m.parked and m.foreground==mode and 1 not in m.calls,'ordinary singles button preserves armed configuration without legacy parking')
+        m.run(m.read32(m.base+0x9fc8),m.base+0x9fbc)
+        check(not m.parked and m.foreground==mode,'ordinary Teams button cancels configuration without cancelling singles')
+    m=machine('tm.dat',stock=True);m.run('PFQ_Entry');m.foreground=255
+    m.run(m.read32(m.base+0x9f70),m.base+0x9f64)
+    check(not m.parked and m.foreground==1,'stock host retains ordinary solo dispatch')
+    m=machine('other.dat');m.parked=True;m.connected=True;m.token=11;m.foreground=1
+    m.write(0x804d6640,b'\x01');m.run('PFQ_Entry');m.run('PFQ_Frame',0x81700000)
+    check(m.parked and 3 not in m.calls,'singles CSS restarts before activation')
+    m.run('PFQ_OnExit')
+    check(('next_minor',0) in m.actions and ('next_major',8) in m.actions and ('commit_major',8) in m.actions,'CSS exit requests a fresh VS CSS after ordinary cleanup')
+    m.run('PFQ_Entry');m.busy=True;m.run('PFQ_Frame',0x81700000)
+    check(m.parked,'busy report/replay cannot activate Teams')
+    cleanups=m.actions.count('cleanup');m.run('PFQ_Frame',0x81700000)
+    check(m.actions.count('cleanup')==cleanups,'waiting for report/replay does not repeatedly clean up')
+    m.busy=False;m.run('PFQ_Frame',0x81700000)
+    check(not m.parked and m.foreground==3,'Teams activates once the lifecycle barrier releases')
+    check(m.u.mem_read(0x804d666a,1)==b'\x01','existing chose-stage flag enables ready Teams selections')
+    m.run('PFQ_Frame',0x81700000)
+    check(m.old_frames==1,'normal L+R handler resumes after handoff')
+    print(checks,'compiled PowerPC adapter/relocation/ABI checks passed. Mock game services only; no Dolphin or online match ran.')
+
+if __name__=='__main__':
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--originals',type=Path,required=True);ap.add_argument('--objects',type=Path,required=True)
+    args=ap.parse_args();main()
