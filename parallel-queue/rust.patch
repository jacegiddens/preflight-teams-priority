+/// Creates an independent matchmaking client sharing the device's user identity.
+/// Dolphin serializes this call with other opaque EXI-device calls. Thereafter
+/// each handle is owned by one C++ matchmaking context and used by its worker;
+/// destruction happens only after that worker has joined.
+#[unsafe(no_mangle)]
+pub extern "C" fn slprs_mm_client_create(exi_device_instance_ptr: usize) -> usize {
+    with_returning::<SlippiEXIDevice, _, _>(exi_device_instance_ptr, |device| {
+        Box::into_raw(Box::new(device.matchmaking.independent())) as usize
     })
 }
 
+/// Destroys exactly this independent client; no other ticket is cancelled.
+#[unsafe(no_mangle)]
+pub extern "C" fn slprs_mm_client_destroy(client: usize) {
+    if client != 0 {
+        drop(unsafe { Box::from_raw(client as *mut MatchmakingClient) });
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn slprs_mm_client_start(client: usize, request: SlippiMatchmakingRequest) -> u64 {
+    with_returning::<MatchmakingClient, _, _>(client, |mm| mm.start(match_request(request)))
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn slprs_mm_client_state(client: usize) -> c_int {
+    with_returning::<MatchmakingClient, _, _>(client, |mm| mm.state() as c_int)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn slprs_mm_client_take_result_json(client: usize) -> *mut c_char {
+    with_returning::<MatchmakingClient, _, _>(client, |mm| {
+        mm.take_result_json()
+            .and_then(|json| CString::new(json).ok())
+            .map(CString::into_raw)
+            .unwrap_or(std::ptr::null_mut())
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn slprs_mm_client_error_message(client: usize) -> *mut c_char {
+    with_returning::<MatchmakingClient, _, _>(client, |mm| {
+        CString::new(mm.error_message())
+            .map(CString::into_raw)
+            .unwrap_or(std::ptr::null_mut())
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn slprs_mm_client_cancel(client: usize, session_id: u64) {
+    with::<MatchmakingClient, _>(client, |mm| mm.cancel_session(session_id));
+}
