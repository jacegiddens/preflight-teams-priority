index 0000000..9d385b5
--- /dev/null
+++ b/Development/SingleInstance/SessionBarrierTest.cpp
@@ -0,0 +1,35 @@
+// Copyright 2026 Dolphin Emulator Project
+// Licensed under GPLv2+
+// Refer to the license.txt file included.
+#include "Core/Slippi/SlippiSessionBarrier.h"
+#include <iostream>
+#include <stdexcept>
+#include <thread>
+int checks = 0;
+void Check(bool value, const char* reason) { if (!value) throw std::runtime_error(reason); ++checks; }
+int main()
+{
+  SlippiSessionBarrier b;
+  Check(b.Idle(), "fresh session can activate");
+  b.BeginOnlineGame();
+  Check(!b.OnlineIdle(), "online gameplay prevents parking");
+  Check(!b.Idle(), "live gameplay blocks activation");
+  b.EndGame();
+  Check(!b.OnlineIdle(), "outstanding report prevents parking");
+  Check(!b.Idle(), "game end still waits for report");
+  b.ReplayQueued();b.ReportFinished();
+  Check(b.OnlineIdle(), "offline replay drain need not prevent parking practice Teams");
+  Check(!b.Idle(), "finished report still waits for replay worker");
+  std::thread write([&]{b.ReplayWritten();});write.join();
+  Check(b.Idle(), "game, report and replay completed permit handoff");
+  b.BeginOnlineGame();b.ReportFinished();
+  Check(!b.Idle(), "early report does not bypass gameplay exit");
+  b.EndGame();Check(b.Idle(), "reverse report/end order also releases gate");
+  b.ReplayQueued();b.ReplayQueued();
+  Check(!b.Idle(), "multiple replay messages block handoff");
+  b.ReplayWritten();Check(!b.Idle(), "partial replay drain cannot hand off");
+  b.ReplayWritten();Check(b.Idle(), "entire replay drain permits handoff");
+  b.BeginOnlineGame();b.EndGame();b.ReportFinished();
+  Check(b.Idle(), "subsequent singles game has independent lifecycle");
+  std::cout << checks << " game/report/replay handoff barrier checks passed.\n";
+}
