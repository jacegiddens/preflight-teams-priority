+#!/usr/bin/env python3
+"""Check the caption patch against the supplied DOL's real PPC SIS routines."""
+import argparse
+import hashlib
+import struct
+from pathlib import Path
+from unicorn import Uc, UC_ARCH_PPC, UC_MODE_32, UC_MODE_BIG_ENDIAN
+from unicorn import ppc_const as P
+from build_preflight_caption import build, caption, encode_line, TITLE, CREDIT, HEADER_OFFSET
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('original_gct', type=Path)
+    parser.add_argument('dol', type=Path)
+    args = parser.parse_args()
+    original = args.original_gct.read_bytes()
+    updated = build(original)
+    dol = args.dol.read_bytes()
+    assert hashlib.sha256(dol).hexdigest() == 'f604e1399f2dc88e2fbbaa2b3441867ca34d00b99b82e16bee4e4ef108604805'
+    at = HEADER_OFFSET
+    size = struct.unpack_from('>I', updated, at+4)[0]*8
+    assert updated[:at] == original[:at]
+    assert updated[at+8+size:] == original[at+8+128:]
+    assert size % 8 == 0 and updated[at+8+size-4:at+8+size] == b'\0'*4
+    machine = Uc(UC_ARCH_PPC, UC_MODE_32 | UC_MODE_BIG_ENDIAN)
+    machine.mem_map(0x80000000, 0x1800000)
+    for i in range(18):
+        off, address, length = [struct.unpack_from('>I', dol, field+4*i)[0] for field in (0, 0x48, 0x90)]
+        if length:
+            machine.mem_write(address, dol[off:off+length])
+    # Execute the generated C2 body. Both Training and all other SIS IDs must
+    # preserve every GPR except r0, and other IDs must keep their original pointer.
+    code, text = 0x81600000, 0x81500000
+    machine.mem_write(code, updated[at+8:at+8+size])
+    for sis_id in (0, 1, 0x89, 0x8A, 0x8B, 0xFFFF):
+        registers = {i: 0x80010000 + i*0x100 for i in range(32)}
+        registers.update({0: 0x80501234, 4: sis_id, 31: text})
+        for i, value in registers.items():
+            machine.reg_write(getattr(P, 'UC_PPC_REG_'+str(i)), value)
+        machine.reg_write(P.UC_PPC_REG_LR, 0x817F0000)
+        machine.emu_start(code, code+size-4, count=32)
+        pointer = struct.unpack('>I', machine.mem_read(text+0x5C, 4))[0]
+        assert pointer == (code+12 if sis_id == 0x8A else registers[0])
+        for i, value in registers.items():
+            if i:
+                assert machine.reg_read(getattr(P, 'UC_PPC_REG_'+str(i))) == value
+        if sis_id == 0x8A:
+            assert bytes(machine.mem_read(pointer, len(caption()))) == caption()
+    # The game's own copier must consume the complete two-line SIS string.
+    source, dest, stop = 0x80500000, 0x80510000, 0x817F0000
+    machine.mem_write(source, caption())
+    machine.mem_write(dest, b'\xEE'*1024)
+    for i, value in ((1,0x817E0000),(2,0x804DF9E0),(13,0x804DB6A0),(3,dest),(4,source)):
+        machine.reg_write(getattr(P, 'UC_PPC_REG_'+str(i)), value)
+    machine.reg_write(P.UC_PPC_REG_LR, stop)
+    machine.emu_start(0x803A6478, stop, count=10000)
+    copied = bytes(machine.mem_read(dest, len(caption())))
+    assert copied == caption()
+    assert bytes(machine.mem_read(dest+len(caption()), 4)) == b'\xEE'*4
+    # Confirm newline opcode 3 reaches the real renderer's line-advance case.
+    newline_case = struct.unpack('>I', machine.mem_read(0x8040C614+3*4,4))[0]
+    assert newline_case == 0x803A8B10
+    assert struct.unpack('>I',machine.mem_read(newline_case+0x38,4))[0] == 0xD01F0074
+    # Real font margins: new lines must fit the old caption's horizontal span.
+    def width(encoded):
+        total = 0
+        i = 0
+        while i < len(encoded):
+            if encoded[i] == 0x1A:
+                total += 16
+                i += 1
+            else:
+                index = int.from_bytes(encoded[i:i+2],'big')-0x2000
+                total += 34-sum(machine.mem_read(0x8040CB00+2*index,2))
+                i += 2
+        return total
+    old_glyphs = original[at+8+12+17:at+8+0x74].split(bytes.fromhex('19 0f 0d 00'))[0]
+    old_width = width(old_glyphs)*179/256
+    widths = [width(encode_line(line))*96/256 for line in (TITLE,CREDIT)]
+    assert all(0 < w < old_width for w in widths)
+    assert caption().count(b'\x03') == 1
+    print('Caption: six real PPC selector paths, complete native SIS copy, newline case, unchanged other codes and font-width checks passed.')
+    print('Native font widths: old %.2f; new %.2f / %.2f. Two 12-unit lines; live rendering still needs checking.' % (old_width,*widths))
+
+
+if __name__ == '__main__':
+    main()
