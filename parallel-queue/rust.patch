+    /// Creates an independent queue using the same identity, version and endpoint.
+    /// The ticket, cancellation flag, result and worker are never shared. In
+    /// particular, equal session numbers on two clients refer to different queues.
+    pub fn independent(&self) -> Self {
+        Self {
+            user_manager: self.user_manager.clone(),
+            slippi_semver: self.slippi_semver.clone(),
+            url: self.url.clone(),
+            inner: Mutex::new(Inner {
+                shared: Arc::new(Shared::default()),
+                worker: None,
+                session_id: 0,
+            }),
+        }
+    }
