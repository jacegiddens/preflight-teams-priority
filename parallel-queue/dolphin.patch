+++ b/Development/SingleInstance/Tools/build_preflight_modules.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Build experimental Preflight v1.1 DAT adapters from exact original modules.
+Requires pyelftools and big-endian PowerPC relocatable hook objects. No ISO is
+modified. Output is for development testing with the matching Dolphin fork.
+"""
+import argparse
+import hashlib
+import io
+from pathlib import Path
+import struct
+from analyze_preflight import Module
+from elftools.elf.elffile import ELFFile
+
+HASHES = {
+    'tm.dat': '2a46fda61b0b175c425687bab074b9b06606325bedf3caa5c39e1984007da920',
+    'other.dat': '85757d8ede9fef7b69e522fb4a7e38f2f126758f918f6dae14276043c42ca76b',
+}
+COMMON = {'Slippi_EXI_Transfer': 0x800055f0, 'scene_info': 0x80479d30,
+          'online_mode': 0x804d6640, 'chose_stage': 0x804d666a,
+          'Scene_ExitMinor': 0x801a4b60, 'Scene_SetNextMinor': 0x801a42a0,
+          'Scene_SetNextMajor': 0x801a42e8, 'Scene_CommitMajor': 0x801a42d4}
+
+def add_object(code, data, imports):
+    elf = ELFFile(io.BytesIO(data))
+    if elf.elfclass != 32 or elf.little_endian or elf['e_machine'] != 'EM_PPC' or elf['e_type'] != 'ET_REL':
+        raise ValueError('Expected big-endian ELF32 PowerPC relocatable object')
+    section = elf.get_section_by_name('.pfq')
+    if section is None or section['sh_type'] != 'SHT_PROGBITS':
+        raise ValueError('Missing combined .pfq section')
+    section_index = next(i for i, s in enumerate(elf.iter_sections()) if s.name == '.pfq')
+    base = len(code)
+    if base % 4: raise ValueError('Unaligned module extension')
+    code.extend(section.data())
+    code.extend(b'\0' * (-len(code) % 4))
+    symbols = elf.get_section_by_name('.symtab')
+    def target(symbol):
+        if symbol['st_shndx'] == 'SHN_UNDEF':
+            if symbol.name not in imports: raise ValueError('Unresolved import: ' + symbol.name)
+            return imports[symbol.name]
+        if symbol['st_shndx'] == section_index: return base + symbol['st_value']
+        raise ValueError('Unsupported symbol section: ' + symbol.name)
+    exports = {s.name: target(s) for s in symbols.iter_symbols()
+               if s.name.startswith('PFQ_') and s['st_shndx'] == section_index}
+    relocs = []
+    for section in elf.iter_sections():
+        if section['sh_type'] != 'SHT_RELA': continue
+        if section['sh_info'] != section_index: raise ValueError('Relocation outside .pfq')
+        for r in section.iter_relocations():
+            kind, site = r['r_info_type'], base + r['r_offset']
+            if kind not in (1,4,6,10,26): raise ValueError('Unsupported PowerPC relocation: ' + str(kind))
+            value = target(symbols.get_symbol(r['r_info_sym'])) + r['r_addend']
+            if not (0 <= value <= 0xffffffff): raise ValueError('Relocation target overflow')
+            # RELA addends live in the record. Clear them out of the instruction
+            # field, preserving branch opcode/AA/LK; the HSD loader fills these.
+            if kind in (4,6): struct.pack_into('>H', code, site, 0)
+            elif kind == 10:
+                word = struct.unpack_from('>I', code, site)[0]
+                if word >> 26 != 18: raise ValueError('REL24 is not a branch')
+                struct.pack_into('>I', code, site, word & 0xfc000003)
+            else: struct.pack_into('>I', code, site, 0)
+            relocs.append(dict(site=site, type=kind, target=value))
+    return exports, relocs
+
+def archive(code, relocs, entry):
+    if len(code) % 4 or len({r['site'] for r in relocs}) != len(relocs):
+        raise ValueError('Unaligned extension or duplicate relocations')
+    body = bytearray(code)
+    reloc_offset = len(body)
+    for r in relocs:
+        body.extend(struct.pack('>2I', (r['type'] << 24) | r['site'], r['target']))
+    lookup = len(body)
+    body.extend(struct.pack('>2I', 0, entry))
+    root = len(body)
+    body.extend(struct.pack('>6I', 0, reloc_offset, len(relocs), lookup, 1, reloc_offset))
+    table = struct.pack('>3I', root, root + 4, root + 12) + struct.pack('>2I', root, 0) + b'fns\0'
+    size = 32 + len(body) + len(table)
+    result = struct.pack('>5I', size, len(body), 3, 1, 0) + b'\0' * 12 + body + table
+    checked = Module(result)
+    for base in [0x80010000, 0x80700000, 0x81000000, 0x81700000]: checked.relocated(base)
+    return result
+
+def build(name, original, hook_object):
+    if name not in HASHES or hashlib.sha256(original).hexdigest() != HASHES[name]:
+        raise ValueError('This is not the exact supported Preflight v1.1 ' + name)
+    module = Module(original)
+    code = bytearray(module.code)
+    old_relocs = [dict(r) for r in module.relocs]
+    imports = dict(COMMON)
+    if name == 'tm.dat':
+        imports.update(Original_Entry=0x9054, Original_Frame=0x8d40,
+                       Original_Unranked=0x4884, Original_Direct=0x4588,
+                       root_row_count=0xc494, queue_counter=0xc1c8, exit_to_slippi=0xa1bc,
+                       menu_head=0xc1d8,
+                       singles_context=len(code) + ((ELFFile(io.BytesIO(hook_object)).get_section_by_name('.pfq')['sh_size']+3)&~3) + 6*44)
+    else: imports.update(Original_Entry=0x208, Original_Frame=0, Original_OnExit=0xe8, lr_exit=0x380)
+    exports, new_relocs = add_object(code, hook_object, imports)
+    if name == 'tm.dat':
+        # Keep the original 5 rows, including the dynamically populated CPU
+        # Actions row. Move their references too, before adding a sixth row.
+        old_rows, old_end, new_rows = 0x9e5c, 0x9f38, len(code)
+        code.extend(module.code[old_rows:old_end] + b'\0' * 44)
+        def moved(target):
+            return new_rows + target - old_rows if old_rows <= target < old_end else target
+        for r in old_relocs: r['target'] = moved(r['target'])
+        for r in module.relocs:
+            if old_rows <= r['site'] < old_end:
+                new_relocs.append(dict(site=new_rows+r['site']-old_rows,type=r['type'],target=moved(r['target'])))
+        context = len(code)
+        code.extend(module.code[0xc408:0xc488])
+        for r in module.relocs:
+            if 0xc408 <= r['site'] < 0xc488:
+                new_relocs.append(dict(site=context+r['site']-0xc408,type=r['type'],target=r['target']))
+        rows = len(code)
+        code.extend(b'\0' * (3 * 44))
+        def pointer(site, value):
+            nonlocal new_relocs
+            new_relocs = [r for r in new_relocs if r['site'] != site]
+            new_relocs.append(dict(site=site,type=1,target=value))
+        def string(value):
+            at=len(code); code.extend(value.encode('ascii')+b'\0');code.extend(b'\0' * (-len(code)%4));return at
+        pointer(context, 0xc488)
+        struct.pack_into('>I', code, context+12, 3)
+        pointer(context+20, rows)
+        root_row = new_rows + 5*44
+        pointer(root_row, string('Play singles'))
+        pointer(root_row+12, 0xa04)
+        pointer(root_row+28, context)
+        for i, (label, callback, argument) in enumerate([
+            ('Unranked', 'PFQ_PlaySingles', 1), ('Direct', 'PFQ_PlaySingles', 2), ('Cancel Teams', 'PFQ_CancelTeams', 0)]):
+            at = rows+i*44
+            pointer(at, string(label))
+            pointer(at+12, exports[callback])
+            struct.pack_into('>I', code, at+24, argument)
+            if argument==2: pointer(at+28, 0xc308)
+        # The original practice GOBJ invokes this through a callback pointer.
+        for r in old_relocs:
+            if r['site'] == 0xc28c:
+                if r['target'] != 0x8d40: raise ValueError('Unexpected practice callback')
+                r['target'] = exports['PFQ_Frame']
+    else:
+        for r in old_relocs:
+            if r['target']==0: r['target']=exports['PFQ_Frame']
+            elif r['target']==0xe8: r['target']=exports['PFQ_OnExit']
+    return archive(code, old_relocs+new_relocs, exports['PFQ_Entry'])
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--originals',type=Path,required=True)
+    ap.add_argument('--objects',type=Path,required=True)
+    ap.add_argument('--output',type=Path,required=True)
+    args=ap.parse_args()
+    if args.output.exists(): ap.error('Choose a new output folder; existing files are preserved')
+    prepared={name:build(name,(args.originals/name).read_bytes(),(args.objects/(name[:-4]+'-hooks.o')).read_bytes()) for name in HASHES}
+    args.output.mkdir(parents=True)
+    for name, data in prepared.items():
+        (args.output/name).write_bytes(data)
+        print(name,len(data),hashlib.sha256(data).hexdigest())
+    print('Experimental module adapters only. No ISO or Windows executable was produced.')
+if __name__=='__main__': main()
